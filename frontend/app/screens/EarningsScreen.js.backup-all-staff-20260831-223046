                  : 10,
            }}
          >
            <View
              style={{
                flex: 1,
              }}
            >
              <FieldLabel>
                Start Date
              </FieldLabel>

              <AppInput
                value={
                  mdyStart
                }

                onChangeText={
                  setMdyStart
                }

                placeholder="MM/DD/YYYY"

                keyboardType="numbers-and-punctuation"

                style={{
                  marginBottom: 9,
                }}
              />

              <FieldLabel>
                Start Time
              </FieldLabel>

              <AppInput
                value={
                  timeStart
                }

                onChangeText={
                  setTimeStart
                }

                placeholder="12:00 AM"

                style={{
                  marginBottom:
                    isPhone
                      ? 13
                      : 0,
                }}
              />
            </View>


            <View
              style={{
                flex: 1,
              }}
            >
              <FieldLabel>
                End Date
              </FieldLabel>

              <AppInput
                value={
                  mdyEnd
                }

                onChangeText={
                  setMdyEnd
                }

                placeholder="MM/DD/YYYY"

                keyboardType="numbers-and-punctuation"

                style={{
                  marginBottom: 9,
                }}
              />

              <FieldLabel>
                End Time
              </FieldLabel>

              <AppInput
                value={
                  timeEnd
                }

                onChangeText={
                  setTimeEnd
                }

                placeholder="11:59 PM"
              />
            </View>
          </View>


          <TouchableOpacity
            activeOpacity={0.85}

            onPress={
              applyDates
            }

            style={{
              minHeight: 48,

              borderRadius:
                RADIUS.medium,

              backgroundColor:
                COLORS.royal,

              alignItems:
                'center',

              justifyContent:
                'center',

              marginTop: 14,
            }}
          >
            <Text
              style={{
                color:
                  COLORS.white,

                fontSize: 14,

                fontWeight:
                  '800',
              }}
            >
              Apply Custom Range
            </Text>
          </TouchableOpacity>
        </Card>


        <View
          style={{
            marginTop:
              18,

            flexDirection:
              'row',

            flexWrap:
              'wrap',

            gap:
              10,
          }}
        >
          {isOwnerOrReception ? (
            <>
              <>
  <MetricCard
    title="Service Revenue"

    value={
      summary
        .services_total
    }

    subtitle="Full amount charged for your services"
  />

  <MetricCard
    title="My Service Earnings — 60%"

    value={
      summary
        .staff_service_earnings
    }

    subtitle="Your share of service revenue"
  />

  <MetricCard
    title="Salon Share — 40%"

    value={
      summary
        .owner_service_share
    }

    subtitle="Amount retained by the salon"
  />

  <MetricCard
    title="Tips"

    value={
      summary
        .tips_total
    }

    subtitle="100% of your tips"
  />

  <MetricCard
    title="Retail"

    value={
      summary
        .sales_total
    }

    subtitle="Gross products linked to your appointments"
  />
</>
            </>
          ) : (
            <>
              <MetricCard
                title="Service Revenue"

                value={
                  summary
                    .services_total
                }

                subtitle="Services you performed"
              />

              <MetricCard
                title="My Service Earnings"

                value={
                  summary
                    .staff_service_earnings
                }

                subtitle="Your 60% service share"
              />

              <MetricCard
                title="Tips"

                value={
                  summary
                    .tips_total
                }

                subtitle="100% of your tips"
              />

              <MetricCard
                title="Retail Sold"

                value={
                  summary
                    .sales_total
                }

                subtitle="Gross products you sold"
              />

              <MetricCard
                title="Product Commission — 20%"

                value={
                  summary
                    .product_commission
                }

                subtitle="Your commission from product sales"
              />
            </>
          )}
        </View>


        {isOwnerOrReception ? (
          <MetricCard
            title="TOTAL SALON REVENUE"

            value={
              summary
                .grand_total
            }

            subtitle={`${fmtDateShort(
              start
            )} – ${fmtDateShort(
              end
            )}`}

            emphasized

            style={{
              marginTop:
                10,
            }}
          />
        ) : (
          <MetricCard
            title="MY EARNINGS"

            value={
              Number(
                summary
                  .staff_service_earnings ||
                0
              ) +
              Number(
                summary
                  .tips_total ||
                0
              ) +
              Number(
                summary
                  .product_commission ||
                0
              )
            }

            subtitle={`${fmtDateShort(
              start
            )} – ${fmtDateShort(
              end
            )} • 60% services + 100% tips + 20% retail commission`}

            emphasized

            style={{
              marginTop:
                10,
            }}
          />
        )}


        <View
          style={{
            marginTop: 22,
          }}
        >
          <SectionTitle
            title="Revenue Mix"

            subtitle="Services and tips grouped by specialty, plus retail sales."
          />

          <Card>
            {revenueMix.length ===
            0 ? (
              <View
                style={{
                  paddingVertical:
                    30,

                  alignItems:
                    'center',
                }}
              >
                <Text
                  style={{
                    color:
                      COLORS.text,

                    fontSize: 16,

                    fontWeight:
                      '800',
                  }}
                >
                  No revenue yet
                </Text>

                <Text
                  style={{
                    color:
                      COLORS.textMuted,

                    fontSize: 12,

                    marginTop: 5,
                  }}
                >
                  There are no earnings in this range.
                </Text>
              </View>
            ) : (
              <>
                <View
                  style={{
                    flexDirection:
                      'row',

                    alignItems:
                      'flex-end',

                    justifyContent:
                      'space-between',

                    marginBottom: 18,
                  }}
                >
                  <View>
                    <Text
                      style={{
                        color:
                          COLORS.textMuted,

                        fontSize: 11,

                        fontWeight:
                          '700',
                      }}
                    >
                      TOTAL
                    </Text>

                    <Text
                      style={{
                        color:
                          COLORS.text,

                        fontSize: 25,

                        fontWeight:
                          '900',

                        marginTop: 3,
                      }}
                    >
                      {money(
                        summary.grand_total
                      )}
                    </Text>
                  </View>

                  <Text
                    style={{
                      color:
                        COLORS.textMuted,

                      fontSize: 11,
                    }}
                  >
                    Selected period
                  </Text>
                </View>


                {revenueMix.map(
                  (
                    item,
                    index
                  ) => (
                    <RevenueBar
                      key={
                        item.key
                      }

                      index={
                        index
                      }

                      label={
                        item.label
                      }

                      value={
                        item.value
                      }

                      total={
                        summary.grand_total
                      }
                    />
                  )
                )}
              </>
            )}
          </Card>
        </View>


        <TaxSection />

        <StaffSection />


        <View
          style={{
            marginTop: 22,

            marginBottom: 12,
          }}
        >
          <SectionTitle
            title={
              isOwnerOrReception
                ? 'Appointments in Range'
                : 'Your Appointments'
            }

            subtitle={
              isOwnerOrReception
                ? 'Appointments contributing to this report.'
                : 'Appointments contributing to your earnings.'
            }
          />
        </View>
      </View>
    );


  /* =====================================================
     APPOINTMENT ROW
  ===================================================== */

  const renderAppointment =
    ({
      item,
    }) => (
      <Card
        style={{
          marginBottom: 10,
        }}
      >
        <View
          style={{
            flexDirection:
              'row',

            alignItems:
              'flex-start',
          }}
        >
          <View
            style={{
              width: 4,

              alignSelf:
                'stretch',

              minHeight: 60,

              backgroundColor:
                COLORS.royal,

              borderRadius: 99,

              marginRight: 12,
            }}
          />

          <View
            style={{
              flex: 1,
            }}
          >
            <View
              style={{
                flexDirection:
                  'row',

                justifyContent:
                  'space-between',

                gap: 10,
              }}
            >
              <Text
                style={{
                  color:
                    COLORS.text,

                  fontSize: 15,

                  fontWeight:
                    '800',

                  flex: 1,
                }}
              >
                {item.service_name}
              </Text>

              <Text
                style={{
                  color:
                    COLORS.royal,

                  fontSize: 14,

                  fontWeight:
                    '900',
                }}
              >
                {money(
                  item.price
                )}
              </Text>
            </View>


            <Text
              style={{
                color:
                  COLORS.textSecondary,

                fontSize: 12,

                marginTop: 5,
              }}
            >
              {fmtDateShort(
                item.start_time
              )}
              {' • '}
              {fmtTime12(
                item.start_time
              )}
              {' – '}
              {fmtTime12(
                item.end_time
              )}
            </Text>


            <Text
              style={{
                color:
                  COLORS.textMuted,

                fontSize: 11,

                marginTop: 5,
              }}
            >
              {getClientName(
                item.client_id
              )}
              {' • '}
              {getStaffName(
                item.staff_id
              )}
            </Text>


            {Number(
              item.tip ||
              0
            ) > 0 && (
              <Text
                style={{
                  color:
                    COLORS.textMuted,

                  fontSize: 11,

                  marginTop: 3,
                }}
              >
                Tip:{' '}
                {money(
                  item.tip
                )}
              </Text>
            )}
          </View>
        </View>
      </Card>
    );


  /* =====================================================
     RENDER
  ===================================================== */

  return (
    <View
      style={{
        flex: 1,

        backgroundColor:
          COLORS.background,
      }}
    >
      <TouchableWithoutFeedback
        onPress={
          Keyboard.dismiss
        }

        accessible={
          false
        }
      >
        <FlatList
          data={
            appointments
          }

          keyExtractor={(
            appointment
          ) =>
            String(
              appointment.id
            )
          }

          renderItem={
            renderAppointment
          }

          ListHeaderComponent={
            Header
          }

          ListEmptyComponent={
            !loading ? (
              <Card>
                <Text
                  style={{
                    color:
                      COLORS.text,

                    fontSize: 15,

                    fontWeight:
                      '800',

                    textAlign:
                      'center',
                  }}
                >
                  No appointments in this range
                </Text>

                <Text
                  style={{
                    color:
                      COLORS.textMuted,

                    fontSize: 12,

                    textAlign:
                      'center',

                    marginTop: 5,
                  }}
                >
                  Choose another reporting period to view earnings activity.
                </Text>
              </Card>
            ) : null
          }

          refreshing={
            loading
          }

          onRefresh={async () => {
            try {
              setLoading(
                true
              );

              await loadAll(
                start,
                end
              );
            } catch (
              error
            ) {
              Alert.alert(
                'Refresh failed',
                String(
                  error.message ||
                  error
                )
              );
            } finally {
              setLoading(
                false
              );
            }
          }}

          contentContainerStyle={{
            width: '100%',

            maxWidth:
              isDesktop
                ? 1200
                : 950,

            alignSelf:
              'center',

            padding:
              contentPadding,

            paddingBottom:
              40,
          }}

          keyboardDismissMode="on-drag"

          keyboardShouldPersistTaps="handled"

          showsVerticalScrollIndicator={
            false
          }
        />
      </TouchableWithoutFeedback>
    </View>
  );
}