/* =========================================================
   MAIN SCREEN
========================================================= */

export default function EarningsScreen({
  token,
  me,
}) {
  const {
    width,
  } =
    useWindowDimensions();


  const isPhone =
    width < 700;

  const isTablet =
    width >= 700 &&
    width < 1100;

  const isDesktop =
    width >= 1100;


  const contentPadding =
    isDesktop
      ? 28
      : isTablet
        ? 22
        : 16;


  const role =
    me?.role ??
    'staff';


  const isOwnerOrReception =
    role === 'owner' ||
    role === 'receptionist';


  const authHeaders =
    useMemo(
      () => ({
        Authorization:
          `Bearer ${token}`,

        'Content-Type':
          'application/json',
      }),
      [token]
    );


  const initialMonth =
    useMemo(
      () =>
        thisMonth(),
      []
    );


  const [
    start,
    setStart,
  ] =
    useState(
      initialMonth.start
    );


  const [
    end,
    setEnd,
  ] =
    useState(
      initialMonth.end
    );


  const [
    mdyStart,
    setMdyStart,
  ] =
    useState(
      fmtMDY(
        initialMonth.start
      )
    );


  const [
    mdyEnd,
    setMdyEnd,
  ] =
    useState(
      fmtMDY(
        initialMonth.end
      )
    );


  const [
    timeStart,
    setTimeStart,
  ] =
    useState(
      '12:00 AM'
    );


  const [
    timeEnd,
    setTimeEnd,
  ] =
    useState(
      '11:59 PM'
    );


  const [
    activePreset,
    setActivePreset,
  ] =
    useState('tm');


  const [
    loading,
    setLoading,
  ] =
    useState(true);


  const [
    summary,
    setSummary,
  ] =
    useState({
      services_total:
        0,

      staff_service_earnings:
        0,

      owner_service_share:
        0,

      tips_total:
        0,

      sales_total:
        0,

      product_commission:
        0,

      salon_retail_share:
        0,

      grand_total:
        0,
    });


  const [
    appointments,
    setAppointments,
  ] =
    useState([]);


  const [
    clients,
    setClients,
  ] =
    useState([]);


  const [
    staff,
    setStaff,
  ] =
    useState([]);


  const [
    byStaff,
    setByStaff,
  ] =
    useState({
      staff: [],

      totals: {
        services_total:
          0,

        staff_service_earnings:
          0,

        owner_service_share:
          0,

        tips_total:
          0,

        sales_total:
          0,

        staff_earnings_total:
          0,

        grand_total:
          0,
      },
    });


  const [
    taxes,
    setTaxes,
  ] =
    useState(null);


  /* =====================================================
     API
  ===================================================== */

  async function fetchOk(
    url,
    options
  ) {
    const response =
      await fetch(
        url,
        options
      );

    if (!response.ok) {
      const text =
        await response.text();

      throw new Error(
        `${response.status} ${text}`
      );
    }

    return response;
  }


  const makeRangeURL =
    (
      endpoint,
      rangeStart,
      rangeEnd
    ) => {
      const url =
        new URL(
          `${API_BASE_URL}${endpoint}`
        );

      if (rangeStart) {
        url.searchParams.set(
          'start',
          rangeStart
        );
      }

      if (rangeEnd) {
        url.searchParams.set(
          'end',
          rangeEnd
        );
      }

      return url;
    };


  const loadAll =
    async (
      rangeStart = start,
      rangeEnd = end
    ) => {
      const summaryURL =
        makeRangeURL(
          '/earnings/',
          rangeStart,
          rangeEnd
        );


      const appointmentsURL =
        makeRangeURL(
          '/appointments/',
          rangeStart,
          rangeEnd
        );


      const taxesURL =
        makeRangeURL(
          '/earnings/taxes',
          rangeStart,
          rangeEnd
        );


      const tasks = [
        fetchOk(
          summaryURL.toString(),
          {
            headers:
              authHeaders,
          }
        )
          .then(
            (response) =>
              response.json()
          )
          .then(
            setSummary
          ),

        fetchOk(
          appointmentsURL.toString(),
          {
            headers:
              authHeaders,
          }
        )
          .then(
            (response) =>
              response.json()
          )
          .then(
            (data) =>
              setAppointments(
                Array.isArray(
                  data
                )
                  ? data
                  : []
              )
          ),

        fetchOk(
          `${API_BASE_URL}/clients/search?limit=200`,
          {
            headers:
              authHeaders,
          }
        )
          .then(
            (response) =>
              response.json()
          )
          .then(
            (data) =>
              setClients(
                Array.isArray(
                  data
                )
                  ? data
                  : []
              )
          ),

        fetchOk(
          taxesURL.toString(),
          {
            headers:
              authHeaders,
          }
        )
          .then(
            (response) =>
              response.json()
          )
          .then(
            setTaxes
          )
          .catch(
            (error) =>
              setTaxes({
                error:
                  String(
                    error.message ||
                    error
                  ),
              })
          ),
      ];


      if (
        isOwnerOrReception
      ) {
        const staffTotalsURL =
          makeRangeURL(
            '/earnings/by-staff',
            rangeStart,
            rangeEnd
          );


        tasks.push(
          fetchOk(
            staffTotalsURL.toString(),
            {
              headers:
                authHeaders,
            }
          )
            .then(
              (response) =>
                response.json()
            )
            .then(
              setByStaff
            )
        );


        tasks.push(
          fetchOk(
            `${API_BASE_URL}/users/?role=staff`,
            {
              headers:
                authHeaders,
            }
          )
            .then(
              (response) =>
                response.json()
            )
            .then(
              (data) =>
                setStaff(
                  Array.isArray(
                    data
                  )
                    ? data
                    : []
                )
            )
        );
      } else {
        setByStaff({
          staff: [],

          totals: {
            services_total:
              0,

            staff_service_earnings:
              0,

            owner_service_share:
              0,

            tips_total:
              0,

            sales_total:
              0,

            staff_earnings_total:
              0,

            grand_total:
              0,
          },
        });

        setStaff([]);
      }


      await Promise.all(
        tasks
      );
    };


  useEffect(
    () => {
      (
        async () => {
          try {
            await loadAll(
              initialMonth.start,
              initialMonth.end
            );
          } catch (
            error
          ) {
            Alert.alert(
              'Error',
              String(
                error.message ||
                error
              )
            );
          } finally {
            setLoading(
              false
            );
          }
        }
      )();
    },
    []
  );


  /* =====================================================
     NAMES
  ===================================================== */

  const getClientName =
    (
      id
    ) => {
      const client =
        clients.find(
          (item) =>
            item.id ===
            id
        );

      return client
        ? `${client.first_name || ''} ${client.last_name || ''}`.trim()
        : `Client #${id}`;
    };


  const getStaffName =
    (
      id
    ) => {
      if (
        id === me?.id &&
        me?.name
      ) {
        return me.name;
      }

      const person =
        staff.find(
          (item) =>
            item.id ===
            id
        );

      return (
        person?.name ||
        `Staff #${id}`
      );
    };


  /* =====================================================
     FILTERS
  ===================================================== */

  const presets = [
    {
      id: 'today',
      label: 'Today',
    },

    {
      id: '7d',
      label: '7 Days',
    },

    {
      id: 'tm',
      label: 'This Month',
    },

    {
      id: 'lm',
      label: 'Last Month',
    },

    {
      id: 'ytd',
      label: 'YTD',
    },
  ];


  const rangeForPreset =
    (
      id
    ) => {
      switch (id) {
        case 'today':
          return {
            start:
              startOfToday(),

            end:
              endOfToday(),
          };

        case '7d':
          return last7Days();

        case 'lm':
          return lastMonth();

        case 'ytd':
          return yearToDate();

        case 'tm':
        default:
          return thisMonth();
      }
    };


  const onPresetPress =
    async (
      id
    ) => {
      try {
        setLoading(true);

        const range =
          rangeForPreset(
            id
          );


        setActivePreset(
          id
        );

        setStart(
          range.start
        );

        setEnd(
          range.end
        );

        setMdyStart(
          fmtMDY(
            range.start
          )
        );

        setMdyEnd(
          fmtMDY(
            range.end
          )
        );

        setTimeStart(
          '12:00 AM'
        );

        setTimeEnd(
          '11:59 PM'
        );


        await loadAll(
          range.start,
          range.end
        );
      } catch (
        error
      ) {
        Alert.alert(
          'Error',
          String(
            error.message ||
            error
          )
        );
      } finally {
        setLoading(
          false
        );
      }
    };


  const applyDates =
    async () => {
      try {
        const parsedStart =
          parseMDY(
            mdyStart
          );

        const parsedEnd =
          parseMDY(
            mdyEnd
          );


        if (
          !parsedStart ||
          !parsedEnd
        ) {
          return Alert.alert(
            'Invalid date',
            'Use MM/DD/YYYY for both dates.'
          );
        }


        const parsedStartTime =
          parseTime12(
            timeStart
          );

        const parsedEndTime =
          parseTime12(
            timeEnd
          );


        if (
          !parsedStartTime ||
          !parsedEndTime
        ) {
          return Alert.alert(
            'Invalid time',
            'Use a time like 9:00 AM or 11:59 PM.'
          );
        }


        const nextStart =
          toISO(
            parsedStart.y,
            parsedStart.m,
            parsedStart.d,
            parsedStartTime.hh,
            parsedStartTime.mm,
            0
          );


        const nextEnd =
          toISO(
            parsedEnd.y,
            parsedEnd.m,
            parsedEnd.d,
            parsedEndTime.hh,
            parsedEndTime.mm,
            59
          );


        if (
          new Date(
            nextEnd
          ) <
          new Date(
            nextStart
          )
        ) {
          return Alert.alert(
            'Invalid range',
            'The end date must be after the start date.'
          );
        }


        setLoading(
          true
        );

        setStart(
          nextStart
        );

        setEnd(
          nextEnd
        );

        setActivePreset(
          null
        );


        await loadAll(
          nextStart,
          nextEnd
        );


        Keyboard.dismiss();
      } catch (
        error
      ) {
        Alert.alert(
          'Error',
          String(
            error.message ||
            error
          )
        );
      } finally {
        setLoading(
          false
        );
      }
