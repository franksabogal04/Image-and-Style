/* =========================================================
   DATE HELPERS
========================================================= */

const pad = (number) =>
  String(number).padStart(2, '0');


function toISO(
  year,
  month,
  day,
  hour = 0,
  minute = 0,
  second = 0
) {
  return (
    `${year}-` +
    `${pad(month)}-` +
    `${pad(day)}` +
    `T${pad(hour)}:` +
    `${pad(minute)}:` +
    `${pad(second)}`
  );
}


function parseMDY(value) {
  if (!value) {
    return null;
  }

  const parts =
    value
      .split('/')
      .map(
        (part) =>
          part.trim()
      );

  if (
    parts.length !== 3
  ) {
    return null;
  }

  const [
    month,
    day,
    year,
  ] =
    parts.map(Number);

  if (
    !year ||
    !month ||
    !day
  ) {
    return null;
  }

  return {
    y: year,
    m: month,
    d: day,
  };
}


function parseTime12(value) {
  if (!value) {
    return {
      hh: 0,
      mm: 0,
    };
  }

  const match =
    String(value)
      .trim()
      .match(
        /^(\d{1,2}):?(\d{2})?\s*(AM|PM)$/i
      );

  if (!match) {
    return null;
  }

  let hour =
    parseInt(
      match[1],
      10
    );

  const minute =
    match[2]
      ? parseInt(
          match[2],
          10
        )
      : 0;

  const period =
    match[3]
      .toUpperCase();

  if (
    hour < 1 ||
    hour > 12 ||
    minute < 0 ||
    minute > 59
  ) {
    return null;
  }

  if (
    period === 'PM' &&
    hour !== 12
  ) {
    hour += 12;
  }

  if (
    period === 'AM' &&
    hour === 12
  ) {
    hour = 0;
  }

  return {
    hh: hour,
    mm: minute,
  };
}


function fmtMDY(value) {
  return new Date(
    value
  ).toLocaleDateString(
    'en-US',
    {
      month: '2-digit',
      day: '2-digit',
      year: 'numeric',
    }
  );
}


function fmtDateShort(value) {
  return new Date(
    value
  ).toLocaleDateString(
    'en-US',
    {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }
  );
}


function fmtTime12(value) {
  return new Date(
    value
  )
    .toLocaleTimeString(
      'en-US',
      {
        hour: 'numeric',
        minute: '2-digit',
      }
    )
    .replace(
      'am',
      'AM'
    )
    .replace(
      'pm',
      'PM'
    );
}


function startOfToday() {
  const date =
    new Date();

  return toISO(
    date.getFullYear(),
    date.getMonth() + 1,
    date.getDate(),
    0,
    0,
    0
  );
}


function endOfToday() {
  const date =
    new Date();

  return toISO(
    date.getFullYear(),
    date.getMonth() + 1,
    date.getDate(),
    23,
    59,
    59
  );
}


function last7Days() {
  const endDate =
    new Date();

  const startDate =
    new Date(
      endDate.getTime() -
        6 *
          24 *
          60 *
          60 *
          1000
    );

  return {
    start:
      toISO(
        startDate.getFullYear(),
        startDate.getMonth() + 1,
        startDate.getDate(),
        0,
        0,
        0
      ),

    end:
      toISO(
        endDate.getFullYear(),
        endDate.getMonth() + 1,
        endDate.getDate(),
        23,
        59,
        59
      ),
  };
}


function thisMonth() {
  const date =
    new Date();

  const lastDay =
    new Date(
      date.getFullYear(),
      date.getMonth() + 1,
      0
    ).getDate();

  return {
    start:
      toISO(
        date.getFullYear(),
        date.getMonth() + 1,
        1,
        0,
        0,
        0
      ),

    end:
      toISO(
        date.getFullYear(),
        date.getMonth() + 1,
        lastDay,
        23,
        59,
        59
      ),
  };
}


function lastMonth() {
  const date =
    new Date();

  const previousMonth =
    new Date(
      date.getFullYear(),
      date.getMonth() - 1,
      1
    );

  const lastDay =
    new Date(
      previousMonth.getFullYear(),
      previousMonth.getMonth() + 1,
      0
    ).getDate();

  return {
    start:
      toISO(
        previousMonth.getFullYear(),
        previousMonth.getMonth() + 1,
        1,
        0,
        0,
        0
      ),

    end:
      toISO(
        previousMonth.getFullYear(),
        previousMonth.getMonth() + 1,
        lastDay,
        23,
        59,
        59
      ),
  };
}


function yearToDate() {
  const date =
    new Date();

  return {
    start:
      toISO(
        date.getFullYear(),
        1,
        1,
        0,
        0,
        0
      ),

    end:
      toISO(
        date.getFullYear(),
        date.getMonth() + 1,
        date.getDate(),
        23,
        59,
        59
      ),
  };
}


const fmtPct = (value) =>
  `${Math.round(
    Number(
      value ||
      0
    ) * 100
  )}%`;


const money = (value) =>
  `$${Number(
    value ||
    0
  ).toFixed(2)}`;


