      );


  const moveSelectedDay =
    (
      amount
    ) => {
      const [
        year,
        month,
        day,
      ] =
        selectedDate
          .split('-')
          .map(Number);

      const date =
        new Date(
          year,
          month - 1,
          day
        );

      date.setDate(
        date.getDate() +
        amount
      );

      const nextDate =
        `${date.getFullYear()}-` +
        `${pad(
          date.getMonth() + 1
        )}-` +
        `${pad(
          date.getDate()
        )}`;

      setSelectedDate(
        nextDate
      );

      setSelectedTime(
        null
      );

      setDayViewOpen(
        true
      );
    };


  const previousDay =
    () =>
      moveSelectedDay(-1);


  const nextDay =
    () =>
      moveSelectedDay(1);


  const appointmentStartingAt =
    (
      employeeId,
      time
    ) =>
      appointmentsForStaff(
        employeeId
      ).find(
        (
          appointment
        ) =>
          getTimeKey(
            appointment.start_time
          ) === time
      );


  const appointmentCoveringSlot =
    (
      employeeId,
      time
    ) => {
      const [
        hour,
        minute,
      ] =
        time
          .split(':')
          .map(Number);

      const [
        year,
        month,
        day,
      ] =
        selectedDate
          .split('-')
          .map(Number);

      const slotStart =
        new Date(
          year,
          month - 1,
          day,
          hour,
          minute
        );

      return appointmentsForStaff(
        employeeId
      ).find(
        (
          appointment
        ) => {
          const start =
            new Date(
              appointment.start_time
            );

          const end =
            new Date(
              appointment.end_time
            );

          return (
            slotStart >= start &&
            slotStart < end
          );
        }
      );
    };


  /* =====================================================
     CREATE APPOINTMENT AVAILABILITY
  ===================================================== */

  const selectedDuration =
    useMemo(
      () => {
        const manual =
          (
            parseInt(
              hours || '0',
              10
            ) *
            60
          ) +
          parseInt(
            minutesOverride ||
            '0',
            10
          );

        return Math.max(
          5,
          manual ||
          Number(
            selectedService
              ?.duration_minutes ||
            30
          )
        );
      },
      [
        hours,
        minutesOverride,
        selectedService,
      ]
    );


  const isTimeAvailable =
    (
      time
    ) => {
      if (
        !staffId ||
        !selectedDate
      ) {
        return false;
      }

      const [
        hour,
        minute,
      ] =
        time
          .split(':')
          .map(Number);

      const [
        year,
        month,
        day,
      ] =
        selectedDate
          .split('-')
          .map(Number);

      const start =
        new Date(
          year,
          month - 1,
          day,
          hour,
          minute
        );

      const end =
        new Date(
          start.getTime() +
          selectedDuration *
          60000
        );

      const close =
        new Date(
          year,
          month - 1,
          day,
          CLOSE_TIME,
          0
        );

      if (
        end > close
      ) {
        return false;
      }

      const conflict =
        appointments.some(
          (
            appointment
          ) => {
            if (
              appointment.staff_id !==
              staffId
            ) {
              return false;
            }

            const apptStart =
              new Date(
                appointment.start_time
              );

            const apptEnd =
              new Date(
                appointment.end_time
              );

            return (
              start < apptEnd &&
              end > apptStart
            );
          }
        );

      return !conflict;
    };


