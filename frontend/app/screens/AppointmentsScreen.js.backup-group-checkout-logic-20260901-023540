===================================================== */

const createAppointment =
  async () => {
    const isWalkIn =
      canPickStaff &&
      bookingSource === 'walk_in';

    if (phoneDepositProcessing) {
      return;
    }

    if (!clientId) {
      return Alert.alert(
        'Select client',
        'Choose a client first.'
      );
    }

    if (!specialtySlug) {
      return Alert.alert(
        'Select specialty',
        'Choose a specialty.'
      );
    }

    if (!staffId) {
      return Alert.alert(
        'Select professional',
        'Choose a professional.'
      );
    }

    if (!selectedService) {
      return Alert.alert(
        'Select service',
        'Choose a service.'
      );
    }

    if (!selectedTime) {
      return Alert.alert(
        'Select time',
        'Choose an available time.'
      );
    }

    if (
      !isTimeAvailable(
        selectedTime
      )
    ) {
      return Alert.alert(
        'Time unavailable',
        'The full service no longer fits at this time. Please choose another time.'
      );
    }

    if (
      groupedBookingItems.length > 0
    ) {
      return createGroupedAppointments(
        isWalkIn
      );
    }


    let createdAppointment =
      null;

    try {
      setPhoneDepositProcessing(
        true
      );

      setPhoneDepositStep(
        isWalkIn
          ? 'Creating walk-in...'
          : 'Creating appointment hold...'
      );

      const start =
        `${selectedDate}T${selectedTime}:00`;

      const end =
        addMinutesLocal(
          start,
          selectedDuration
        );

      const notes =
        `${specialtyLabel}` +
        ` | $${Number(
          price || 0
        ).toFixed(2)}` +
        ` | ${selectedDuration} min`;


      const appointmentResponse =
        await fetchOk(
          `${API_BASE_URL}/appointments/`,
          {
            method:
              'POST',

            headers:
              authHeaders,

            body:
              JSON.stringify(
                {
                  client_id:
                    Number(
                      clientId
                    ),

                  staff_id:
                    Number(
                      staffId
                    ),

                  booking_source:
                    isWalkIn
                      ? 'walk_in'
                      : 'phone',

                  service_id:
                    Number(
                      selectedService.id
                    ),

                  service_name:
                    selectedService.name,

                  start_time:
                    start,

                  end_time:
                    end,

                  notes,

                  price:
                    Number(
                      price ||
                      0
                    ),

                  tip:
                    0,
                }
              ),
          }
        );


      createdAppointment =
        await appointmentResponse.json();


      if (isWalkIn) {
        await loadAppointments();

        setSelectedTime(
          null
        );

        setCreateOpen(
          false
        );

        setDayViewOpen(
          true
        );

        return;
      }


      const depositAmount =
        Number(
          createdAppointment
            ?.deposit_amount ||
          (
            Number(
              price ||
              0
            )
            * 0.25
          )
        );


      setPhoneDepositStep(
        `Collecting $${depositAmount.toFixed(
          2
        )} deposit...`
      );


      await fetchOk(
        `${API_BASE_URL}/payments/appointment/${createdAppointment.id}/moto-deposit/start`,
        {
          method:
            'POST',

          headers:
            authHeaders,
        }
      );


      setPhoneDepositStep(
        'Waiting for Stripe reader...'
      );


      let completed =
        false;

      let lastStatus =
        null;


      for (
        let attempt = 0;
        attempt < 120;
        attempt += 1
      ) {
        await new Promise(
          (
            resolve
          ) =>
            setTimeout(
              resolve,
              1000
            )
        );


        const statusResponse =
          await fetchOk(
            `${API_BASE_URL}/payments/appointment/${createdAppointment.id}/moto-deposit/status`,
            {
              headers:
                authHeaders,
            }
          );


        lastStatus =
          await statusResponse.json();


        if (
          lastStatus?.complete &&
          lastStatus?.booking_status ===
          'confirmed'
        ) {
          completed =
            true;

          break;
        }


        if (
          lastStatus?.ok ===
          false
        ) {
          throw new Error(
            lastStatus?.error ||
            'The deposit was not completed.'
          );
        }


        setPhoneDepositStep(
          'Confirming deposit...'
        );
      }


      if (!completed) {
        throw new Error(
          'Stripe is still processing the deposit. Check the appointment again before retrying.'
        );
      }


      await loadAppointments();


      setSelectedTime(
        null
      );

      setCreateOpen(
        false
      );

      setDayViewOpen(
        true
      );

    } catch (error) {
      await loadAppointments();

      Alert.alert(
        isWalkIn
          ? 'Walk-in could not be created'
          : 'Deposit not completed',
        String(
          error?.message ||
          error
        )
      );

    } finally {
      setPhoneDepositProcessing(
        false
      );

      setPhoneDepositStep('');
    }
  };


