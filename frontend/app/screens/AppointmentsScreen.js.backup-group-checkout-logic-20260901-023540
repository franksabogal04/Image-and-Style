========================================================= */

const pad = (n) =>
  String(n).padStart(2, '0');


function localToday() {
  const d =
    new Date();

  return (
    `${d.getFullYear()}-` +
    `${pad(d.getMonth() + 1)}-` +
    `${pad(d.getDate())}`
  );
}


function generateSlots() {
  const result = [];

  for (
    let hour = OPEN_TIME;
    hour < CLOSE_TIME;
    hour++
  ) {
    for (
      let minute = 0;
      minute < 60;
      minute += SLOT_MINUTES
    ) {
      result.push(
        `${pad(hour)}:${pad(minute)}`
      );
    }
  }

  return result;
}


function addMinutesLocal(
  dateTimeLocalStr,
  minutes
) {
  const [
    dateStr,
    timeStr,
  ] =
    dateTimeLocalStr.split('T');

  const [
    year,
    month,
    day,
  ] =
    dateStr
      .split('-')
      .map(Number);

  const [
    hour,
    minute,
    second,
  ] =
    timeStr
      .split(':')
      .map(Number);

  const base =
    new Date(
      year,
      month - 1,
      day,
      hour,
      minute,
      second || 0
    );

  const added =
    new Date(
      base.getTime() +
      minutes * 60000
    );

  return (
    `${added.getFullYear()}-` +
    `${pad(added.getMonth() + 1)}-` +
    `${pad(added.getDate())}` +
    `T${pad(added.getHours())}:` +
    `${pad(added.getMinutes())}:` +
    `${pad(added.getSeconds())}`
  );
}


function durationMinutes(
  start,
  end
) {
  return Math.max(
    0,
    Math.round(
      (
        new Date(end) -
        new Date(start)
      ) /
      60000
    )
  );
}


function formatTime12(
  value
) {
  if (!value) {
    return '';
  }

  let date;

  if (
    typeof value === 'string' &&
    /^\d{2}:\d{2}$/.test(value)
  ) {
    const [
      hour,
      minute,
    ] =
      value
        .split(':')
        .map(Number);

    date =
      new Date(
        2000,
        0,
        1,
        hour,
        minute
      );
  } else {
    date =
      new Date(value);
  }

  return date.toLocaleTimeString(
    'en-US',
    {
      hour: 'numeric',
      minute: '2-digit',
    }
  );
}


function formatDateLong(
  value
) {
  if (!value) {
    return '';
  }

  const [
    y,
    m,
    d,
  ] =
    value
      .split('-')
      .map(Number);

  return new Date(
    y,
    m - 1,
    d
  ).toLocaleDateString(
    'en-US',
    {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
    }
  );
}


function getTimeKey(
  dateValue
) {
  const d =
    new Date(dateValue);

  return (
    `${pad(d.getHours())}:` +
    `${pad(d.getMinutes())}`
  );
}


function sameLocalDate(
  dateValue,
  dateString
) {
  const d =
    new Date(dateValue);

  return (
    `${d.getFullYear()}-` +
    `${pad(d.getMonth() + 1)}-` +
    `${pad(d.getDate())}`
  ) === dateString;
}


async function fetchOk(
  url,
  options
) {
  const response =
    await fetch(
      url,
      options
    );

  if (!response.ok) {
    const text =
      await response.text();

    throw new Error(
      `${response.status} ${text}`
    );
  }

  return response;
}


