    );
  };


const createGroupedAppointments =
  async (
    isWalkIn
  ) => {
    if (!validateGroupItem()) {
      return;
    }

    const items = [
      ...groupedBookingItems,
      buildBookingItem(),
    ];

    try {
      setPhoneDepositProcessing(
        true
      );

      setPhoneDepositStep(
        isWalkIn
          ? 'Creating grouped walk-in...'
          : 'Creating grouped appointment hold...'
      );

      const response =
        await fetchOk(
          `${API_BASE_URL}/appointments/group`,
          {
            method:
              'POST',

            headers:
              authHeaders,

            body:
              JSON.stringify(
                {
                  client_id:
                    Number(
                      clientId
                    ),

                  booking_source:
                    isWalkIn
                      ? 'walk_in'
                      : 'phone',

                  appointments:
                    items.map(
                      (item) => ({
                        staff_id:
                          item.staff_id,

                        service_id:
                          item.service_id,

                        start_time:
                          item.start_time,

                        end_time:
                          item.end_time,

                        notes:
                          item.notes,

                        price:
                          item.price,

                        tip:
                          0,
                      })
                    ),
                }
              ),
          }
        );

      const grouped =
        await response.json();


      if (!isWalkIn) {
        const deposit =
          Number(
            grouped?.deposit_amount ||
            0
          );

        setPhoneDepositStep(
          `Collecting $${deposit.toFixed(
            2
          )} combined deposit...`
        );

        await fetchOk(
          `${API_BASE_URL}/payments/booking-group/${grouped.booking_group_id}/moto-deposit/start`,
          {
            method:
              'POST',

            headers:
              authHeaders,
          }
        );

        setPhoneDepositStep(
          'Waiting for Stripe reader...'
        );

        let complete =
          false;

        for (
          let attempt = 0;
          attempt < 120;
          attempt += 1
        ) {
          await new Promise(
            (resolve) =>
              setTimeout(
                resolve,
                1000
              )
          );

          const statusResponse =
            await fetchOk(
              `${API_BASE_URL}/payments/booking-group/${grouped.booking_group_id}/moto-deposit/status`,
              {
                headers:
                  authHeaders,
              }
            );

          const status =
            await statusResponse.json();

          if (
            status?.complete &&
            status?.booking_status ===
              'confirmed'
          ) {
            complete =
              true;

            break;
          }

          if (
            status?.ok ===
            false
          ) {
            throw new Error(
              status?.error ||
              'The combined deposit was not completed.'
            );
          }

          setPhoneDepositStep(
            'Confirming combined deposit...'
          );
        }

        if (!complete) {
          throw new Error(
            'Stripe is still processing the combined deposit.'
          );
        }
      }

      await loadAppointments();

      setGroupedBookingItems([]);
      setSelectedTime(null);
      setCreateOpen(false);
      setDayViewOpen(true);

    } catch (error) {
      await loadAppointments();

      Alert.alert(
        isWalkIn
          ? 'Grouped walk-in failed'
          : 'Combined deposit not completed',

        String(
          error?.message ||
          error
        )
      );

    } finally {
      setPhoneDepositProcessing(
        false
      );

      setPhoneDepositStep('');
    }
  };


/* =====================================================
