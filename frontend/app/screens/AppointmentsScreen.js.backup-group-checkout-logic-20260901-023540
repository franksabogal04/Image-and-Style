  /* =====================================================
     STRIPE RETURN REFRESH
  ===================================================== */

  useEffect(() => {
    if (
      Platform.OS !== 'web' ||
      typeof window === 'undefined'
    ) {
      return;
    }

    const params =
      new URLSearchParams(
        window.location.search
      );

    const stripePayment =
      params.get(
        'stripe_payment'
      );

    const returnedAppointmentId =
      Number(
        params.get(
          'appointment_id'
        )
      );


    if (
      stripePayment !==
      'success'
    ) {
      return;
    }


    let cancelled =
      false;

    let attempts =
      0;


    const refreshAfterStripe =
      async () => {
        attempts +=
          1;

        try {
          await loadAppointments();

          if (
            returnedAppointmentId
          ) {
            const response =
              await fetch(
                `${API_BASE_URL}/payments/appointment/${returnedAppointmentId}/summary`,
                {
                  headers:
                    authHeaders,
                }
              );

            if (
              response.ok
            ) {
              const summary =
                await response.json();

              if (
                summary
                  ?.payment_status ===
                'paid'
              ) {
                if (
                  !cancelled
                ) {
                  await loadAppointments();

                  const cleanUrl =
                    window.location
                      .origin +
                    window.location
                      .pathname;

                  window.history
                    .replaceState(
                      {},
                      '',
                      cleanUrl
                    );
                }

                return;
              }
            }
          }
        } catch (error) {
          console.log(
            'Stripe return refresh:',
            error
          );
        }


        if (
          !cancelled &&
          attempts < 6
        ) {
          setTimeout(
            refreshAfterStripe,
            1000
          );
        }
      };


    refreshAfterStripe();


    return () => {
      cancelled =
        true;
