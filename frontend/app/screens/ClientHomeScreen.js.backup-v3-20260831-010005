      if (
        !firstName.trim() ||
        !lastName.trim()
      ) {
        return Alert.alert(
          'Your information',
          'Enter your first and last name.'
        );
      }

      if (booking) {
        return;
      }

      setBooking(true);

      try {
        const params =
          new URLSearchParams();

        params.set(
          'staff_id',
          String(
            selectedStaff.id
          )
        );

        params.set(
          'date',
          selectedDate
        );

        params.set(
          'time',
          selectedTime
        );

        params.set(
          'service_id',
          String(
            selectedService.id
          )
