                )}` +
                `&date=${encodeURIComponent(
                  selectedDate
                )}` +
                `&service_id=${encodeURIComponent(
                  selectedService.id
                )}`
              );

            setAvailableTimes(
              Array.isArray(
                refreshed?.available
              )
                ? refreshed.available
                : []
            );
          } catch {
            setAvailableTimes(
              []
            );
          }


          Alert.alert(
            'Time no longer available',
            'That time was just taken. Please choose another available time.'
          );
        } else {
