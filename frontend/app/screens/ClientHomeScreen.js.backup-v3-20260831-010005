        if (notes.trim()) {
          params.set(
            'notes',
            notes.trim()
          );
        }


        /* -----------------------------------------------
           RECHECK AVAILABILITY BEFORE SAVING
        ----------------------------------------------- */

        const latestAvailabilityUrl =
          `${API_BASE_URL}` +
          `/public/availability` +
          `?staff_id=${encodeURIComponent(
            selectedStaff.id
          )}` +
          `&date=${encodeURIComponent(
            selectedDate
          )}` +
          `&service_id=${encodeURIComponent(
            selectedService.id
          )}`;


        const latestAvailability =
          await fetchJson(
            latestAvailabilityUrl
          );


        const latestTimes =
          Array.isArray(
            latestAvailability?.available
          )
            ? latestAvailability.available
            : [];


        setAvailableTimes(
          latestTimes
        );


        if (
          !latestTimes.includes(
            selectedTime
          )
        ) {
          setSelectedTime(
            null
          );

          Alert.alert(
            'Time no longer available',
            'Another appointment already occupies that time. Please choose a different available time.'
          );

          return;
        }


        /* -----------------------------------------------
           SAVE APPOINTMENT
        ----------------------------------------------- */

        const result =
          await fetchJson(
            `${API_BASE_URL}/public/appointments?${params.toString()}`,
            {
              method: 'POST',
            }
          );


        /*
         * The appointment now exists as pending_deposit.
         *
         * Next, create the Stripe deposit checkout using
         * the secure booking token returned by the backend.
         */

        const depositParams =
          new URLSearchParams();

        depositParams.set(
          'appointment_id',
          String(
            result?.appointment_id
          )
        );

        depositParams.set(
          'booking_token',
          String(
            result?.booking_token
          )
        );


        const checkout =
          await fetchJson(
            `${API_BASE_URL}/payments/public-deposit-checkout?${depositParams.toString()}`,
            {
              method: 'POST',
            }
          );


        if (!checkout?.url) {
          throw new Error(
            'Stripe checkout URL was not returned.'
          );
        }


        /*
         * Save the booking snapshot before leaving
         * the website for Stripe Checkout.
         */

        setConfirmationDetails({
          appointmentId:
            result?.appointment_id,

          customerName:
            `${firstName.trim()} ${lastName.trim()}`,

          staffName:
            selectedStaff.name,

          serviceName:
            selectedService.name,

          date:
            selectedDate,

          time:
            selectedTime,

          duration:
            selectedService.duration_minutes,

          price:
            selectedService.price,

          depositAmount:
            result?.deposit_amount,

          bookingToken:
            result?.booking_token,
        });


        /*
         * Do NOT mark the booking confirmed here.
         *
         * The Stripe webhook will confirm it only
         * after the deposit is actually paid.
         */

        setBookingConfirmed(false);


        if (
          typeof window !== 'undefined'
        ) {
          window.location.href =
            checkout.url;

          return;
        }


        await Linking.openURL(
          checkout.url
        );

      } catch (error) {
        const message =
          String(
            error.message ||
            error
          );


        if (
          message
            .toLowerCase()
            .includes(
              'time unavailable'
            )
        ) {
          setSelectedTime(
