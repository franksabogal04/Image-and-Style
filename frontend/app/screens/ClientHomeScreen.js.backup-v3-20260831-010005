      setBookingConfirmed(false);
      setConfirmationDetails(null);

      setSelectedService(
        service
      );

      setSelectedDate(today);
      setSelectedTime(null);
      setAvailableTimes([]);
    };


  /* =====================================================
     STRIPE DEPOSIT RETURN
  ===================================================== */

  useEffect(() => {
    let cancelled = false;


    const sleep =
      (ms) =>
        new Promise(
          (resolve) =>
            setTimeout(
              resolve,
              ms
            )
        );


    const handleDepositReturn =
      async () => {
        try {
          let returnUrl = null;


          /*
           * Website return from Stripe.
           */
          if (
            typeof window !== 'undefined' &&
            window.location?.href
          ) {
            returnUrl =
              window.location.href;
          }


          /*
           * Native/deep-link fallback.
           */
          if (!returnUrl) {
            returnUrl =
              await Linking.getInitialURL();
          }


          if (!returnUrl) {
            return;
          }


          const url =
            new URL(
              returnUrl
            );


          const depositResult =
            url.searchParams.get(
              'deposit_payment'
            );


          if (!depositResult) {
            return;
          }


          const appointmentId =
            url.searchParams.get(
              'appointment_id'
            );

          const bookingToken =
            url.searchParams.get(
              'booking_token'
            );


          if (
            depositResult ===
            'cancelled'
          ) {
            if (!cancelled) {
              Alert.alert(
                'Deposit not completed',
                'Your appointment has not been confirmed. Please choose your appointment again.'
              );
            }

            return;
          }


          if (
            depositResult !==
            'success'
          ) {
            return;
          }


          if (
            !appointmentId ||
            !bookingToken
          ) {
            throw new Error(
              'Missing booking confirmation information.'
            );
          }


          if (!cancelled) {
            setBooking(true);
          }


          let bookingData = null;


          /*
           * Stripe may redirect the customer a fraction
           * of a second before our webhook finishes.
           *
           * Check a few times before deciding the booking
           * is still pending.
           */
          for (
            let attempt = 0;
            attempt < 8;
            attempt += 1
          ) {
            const params =
              new URLSearchParams();

            params.set(
              'appointment_id',
              appointmentId
            );

            params.set(
              'booking_token',
              bookingToken
            );


            bookingData =
              await fetchJson(
                `${API_BASE_URL}/public/booking-status?${params.toString()}`
              );


            if (
              bookingData
                ?.booking_status ===
              'confirmed'
            ) {
              break;
            }


            await sleep(500);
          }


          if (cancelled) {
            return;
          }


          if (
            bookingData
              ?.booking_status !==
            'confirmed'
          ) {
            throw new Error(
              'Your payment was received, but the booking confirmation is still processing. Please refresh in a moment.'
            );
          }


          const start =
            bookingData?.start_time
              ? new Date(
                  bookingData.start_time
                )
              : null;

          const end =
            bookingData?.end_time
              ? new Date(
                  bookingData.end_time
                )
              : null;


          const date =
            bookingData?.start_time
              ? bookingData
                  .start_time
                  .slice(
                    0,
                    10
                  )
              : '';


          const time =
            bookingData?.start_time
              ? bookingData
                  .start_time
                  .slice(
                    11,
                    16
                  )
              : '';


          let duration = 0;


          if (
            start &&
            end &&
            !Number.isNaN(
              start.getTime()
            ) &&
            !Number.isNaN(
              end.getTime()
            )
          ) {
            duration =
              Math.max(
                0,
                Math.round(
                  (
                    end.getTime() -
                    start.getTime()
                  ) /
                  60000
                )
              );
          }


          setConfirmationDetails({
            appointmentId:
              bookingData
                ?.appointment_id,

            customerName:
              bookingData
                ?.client_name,

            staffName:
              bookingData
                ?.staff_name,

            serviceName:
              bookingData
                ?.service_name,

            date,

            time,

            duration,

            price:
              bookingData
                ?.service_price,

            depositAmount:
              bookingData
                ?.deposit_amount,

            paidTotal:
              bookingData
                ?.paid_total,

            remainingBalance:
              bookingData
                ?.remaining_balance,

            bookingToken,
          });


          setBookingConfirmed(
            true
          );


          /*
           * Remove Stripe query parameters so refreshing
           * the page does not process the payment again.
           */
          if (
            typeof window !==
              'undefined' &&
            window.history
              ?.replaceState
          ) {
            window.history.replaceState(
              {},
              '',
              window.location.pathname
            );
          }


          const scrollToConfirmation =
            () => {
              const targetY =
                servicesSectionYRef.current;

              if (
                !targetY ||
                targetY <= 0
              ) {
                setTimeout(
                  scrollToConfirmation,
                  100
                );

                return;
              }


              pageScrollRef
                .current
                ?.scrollTo({
                  y: Math.max(
                    targetY - 10,
                    0
                  ),
                  animated: false,
                });


              setTimeout(() => {
                if (!cancelled) {
                  setProcessingDepositReturn(
                    false
                  );
                }
              }, 150);
            };


          setTimeout(
            scrollToConfirmation,
            100
          );


        } catch (error) {
          if (!cancelled) {
            setProcessingDepositReturn(
              false
            );

            Alert.alert(
              'Booking confirmation',
              String(
                error?.message ||
                error
              )
            );
          }

        } finally {
          if (!cancelled) {
            setBooking(false);
