def _get_appointment(
    appointment_id: int,
    db: Session,
):
    appointment = (
        db.query(models.Appointment)
        .filter(
            models.Appointment.id
            == appointment_id
        )
        .first()
    )


    if not appointment:
        raise HTTPException(
            status_code=404,
            detail="Appointment not found.",
        )


    return appointment


def _authorize_appointment(
    appointment: models.Appointment,
    current_user: models.User,
):
    """
    Owner and receptionist may work with any appointment.

    Staff may only work with appointments assigned
    to themselves.
    """

    if current_user.role in (
        "owner",
        "receptionist",
    ):
        return


    if (
        current_user.role == "staff"
        and appointment.staff_id
        == current_user.id
    ):
        return


    raise HTTPException(
        status_code=403,
        detail="Forbidden.",
    )


def _validate_tip(
    tip_cents: int,
):
    if tip_cents < 0:
        raise HTTPException(
            status_code=400,
            detail="Tip cannot be negative.",
        )


    # Development safety limit:
    # $1,000 maximum tip.
    if tip_cents > 100000:
        raise HTTPException(
            status_code=400,
            detail="Tip amount is too large.",
        )


def _appointment_sales(
    appointment_id: int,
    db: Session,
):
    return (
        db.query(models.Sale)
        .filter(
            models.Sale.appointment_id
            == appointment_id
        )
        .order_by(
            models.Sale.created_at.asc()
        )
        .all()
    )


def _paid_payments(
    appointment_id: int,
    db: Session,
):
    return (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment_id,
            models.Payment.status
            == "paid",
        )
        .order_by(
            models.Payment.created_at.asc()
        )
        .all()
    )


def _build_totals(
    appointment: models.Appointment,
    db: Session,
    tip_cents: int = None,
):
    """
    Central checkout calculation.

    Never trust the frontend for:

        service price
        product price
        taxes

    Those values all come from our database.
    """

    sales = _appointment_sales(
        appointment.id,
        db,
    )


    service_subtotal = round(
        float(
            appointment.price
            or 0.0
        ),
        2,
    )


    service_tax = round(
        float(
            appointment.service_tax_amount
            or 0.0
        ),
        2,
    )


    product_subtotal = round(
        sum(
            float(
                sale.total_price
                or 0.0
            )
            for sale in sales
        ),
        2,
    )


    product_tax = round(
        sum(
            float(
                sale.retail_tax_amount
                or 0.0
            )
            for sale in sales
        ),
        2,
    )


    if tip_cents is None:
        tip_amount = round(
            float(
                appointment.tip
                or 0.0
            ),
            2,
        )

    else:
        tip_amount = round(
            tip_cents / 100.0,
            2,
        )


    tip_tax_rate = float(
        appointment.tip_tax_rate
        or 0.0
    )


    tip_tax = round(
        tip_amount
        * tip_tax_rate,
        2,
    )


    subtotal = round(
        service_subtotal
        + product_subtotal,
        2,
    )


    tax_total = round(
        service_tax
        + product_tax
        + tip_tax,
        2,
    )


    grand_total = round(
        subtotal
        + tax_total
        + tip_amount,
        2,
    )


    product_lines = []


    for sale in sales:
        product = sale.product

        product_lines.append(
            {
                "sale_id":
                    sale.id,

                "product_id":
                    sale.product_id,

                "name":
                    (
                        product.name
                        if product
                        else f"Product #{sale.product_id}"
                    ),

                "quantity":
                    sale.quantity,

                "subtotal":
                    round(
                        float(
                            sale.total_price
                            or 0.0
                        ),
                        2,
                    ),

                "tax":
                    round(
                        float(
                            sale.retail_tax_amount
                            or 0.0
                        ),
                        2,
                    ),

                "total":
                    round(
                        float(
                            sale.total_with_tax
                            if sale.total_with_tax
                            is not None
                            else sale.total_price
                            or 0.0
                        ),
                        2,
                    ),
            }
        )


    return {
        "service_subtotal":
            service_subtotal,

        "service_tax":
            service_tax,

        "product_subtotal":
            product_subtotal,

        "product_tax":
            product_tax,

        "tip":
            tip_amount,

        "tip_tax":
            tip_tax,

        "tip_tax_rate":
            tip_tax_rate,

        "subtotal":
            subtotal,

        "tax_total":
            tax_total,

        "grand_total":
            grand_total,

        "products":
            product_lines,
    }


def _payment_status(
    appointment_id: int,
    total_due: float,
    db: Session,
):
    payments = _paid_payments(
        appointment_id,
        db,
    )


    paid_total = round(
        sum(
            float(
                payment.amount
                or 0.0
            )
            for payment in payments
        ),
        2,
    )


    refunded_total = float(
        db.query(
            models.Refund
        )
        .with_entities(
            __import__("sqlalchemy").func.coalesce(
                __import__("sqlalchemy").func.sum(
                    models.Refund.amount
                ),
                0.0,
            )
        )
        .filter(
            models.Refund.appointment_id
            == appointment_id,
            models.Refund.status
            == "succeeded",
        )
        .scalar()
        or 0.0
    )

    refunded_total = round(
        refunded_total,
        2,
    )


    net_paid = round(
        max(
            0.0,
            paid_total
            - refunded_total,
        ),
        2,
    )


    if paid_total <= 0:
        status = "unpaid"

    elif (
        refunded_total > 0
        and refunded_total + 0.005
        >= paid_total
    ):
        status = "refunded"

    elif refunded_total > 0:
        status = "partially_refunded"

    elif paid_total + 0.005 < total_due:
        status = "partially_paid"

    else:
        status = "paid"


    # A refund is intentional, so it should not make the
    # appointment look like the client owes a new balance.
    if status in (
        "paid",
        "partially_refunded",
        "refunded",
    ):
        balance_due = 0.0

    else:
        balance_due = round(
            max(
                0.0,
                total_due - paid_total,
            ),
            2,
        )


    return {
        "status":
            status,

        "paid_total":
            paid_total,

        "refunded_total":
            refunded_total,

        "net_paid":
            net_paid,

        "balance_due":
            balance_due,

        "payments":
            [
                {
                    "id":
                        payment.id,

                    "amount":
                        round(
                            float(
                                payment.amount
                                or 0.0
                            ),
                            2,
                        ),

                    "tip_amount":
                        round(
                            float(
                                payment.tip_amount
                                or 0.0
                            ),
                            2,
                        ),

                    "method":
                        payment.method,

                    "status":
                        payment.status,

                    "created_at":
                        payment.created_at,

                    "stripe_checkout_session_id":
                        payment.stripe_checkout_session_id,

                    "stripe_payment_intent_id":
                        payment.stripe_payment_intent_id,
                }
                for payment in payments
            ],
    }


def _update_appointment_tip(
    appointment: models.Appointment,
    tip_amount: float,
):
    """
    Save the final tip on the appointment and refresh
    the appointment tax snapshot.

    Products have their own Sale tax snapshots.
    """

    appointment.tip = round(
        float(tip_amount),
        2,
    )


    tip_tax_rate = float(
        appointment.tip_tax_rate
        or 0.0
    )


    tip_tax = round(
        appointment.tip
        * tip_tax_rate,
        2,
    )


    appointment.tip_tax_amount = (
        tip_tax
    )


    service_tax = float(
        appointment.service_tax_amount
        or 0.0
    )


    appointment.total_with_tax = round(
        float(
            appointment.price
            or 0.0
        )
        + appointment.tip
        + service_tax
        + tip_tax,
        2,
    )


# =========================================================
# APPOINTMENT CHECKOUT SUMMARY
# =========================================================

@router.get(
    "/appointment/{appointment_id}/summary"
)
def appointment_payment_summary(
    appointment_id: int,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    appointment = _get_appointment(
        appointment_id,
        db,
    )


    _authorize_appointment(
        appointment,
        current_user,
    )


    totals = _build_totals(
        appointment,
        db,
    )


    payment = _payment_status(
        appointment.id,
        totals["grand_total"],
        db,
    )


    # =====================================================
    # REFUND AVAILABILITY / HISTORY
    # =====================================================

    successful_refunds = (
        db.query(models.Refund)
        .filter(
            models.Refund.appointment_id
            == appointment.id,
            models.Refund.status
            == "succeeded",
        )
        .order_by(
            models.Refund.created_at.asc()
        )
        .all()
    )


    refund_ids = [
        refund.id
        for refund in successful_refunds
    ]


    refund_lines = []

    if refund_ids:
        refund_lines = (
            db.query(models.RefundLine)
            .filter(
                models.RefundLine.refund_id.in_(
                    refund_ids
                )
            )
            .order_by(
                models.RefundLine.created_at.asc()
            )
            .all()
        )


    refunded_service = any(
        line.kind == "service"
        for line in refund_lines
    )


    refunded_tip = any(
        line.kind == "tip"
        for line in refund_lines
    )


    refunded_sale_ids = [
        line.sale_id
        for line in refund_lines
        if (
            line.kind == "product"
            and line.sale_id is not None
        )
    ]


    refund_history = []

    lines_by_refund = {}

    for line in refund_lines:
        lines_by_refund.setdefault(
            line.refund_id,
            [],
        ).append(
            {
                "id":
                    line.id,

                "kind":
                    line.kind,

                "sale_id":
                    line.sale_id,

                "staff_id":
                    line.staff_id,

                "description":
                    line.description,

                "quantity":
                    line.quantity,

                "subtotal":
                    round(
                        float(
                            line.subtotal
                            or 0.0
                        ),
                        2,
                    ),

                "tax_amount":
                    round(
                        float(
                            line.tax_amount
                            or 0.0
                        ),
                        2,
                    ),

                "total":
                    round(
                        float(
                            line.total
                            or 0.0
                        ),
                        2,
                    ),
            }
        )


    for refund in successful_refunds:
        refund_history.append(
            {
                "id":
                    refund.id,

                "payment_id":
                    refund.payment_id,

                "method":
                    refund.method,

                "status":
                    refund.status,

                "amount":
                    round(
                        float(
                            refund.amount
                            or 0.0
                        ),
                        2,
                    ),

                "reason":
                    refund.reason,

                "stripe_refund_id":
                    refund.stripe_refund_id,

                "created_at":
                    refund.created_at,

                "lines":
                    lines_by_refund.get(
                        refund.id,
                        [],
                    ),
            }
        )


    return {
        "appointment_id":
            appointment.id,

        "service_name":
            appointment.service_name,

        "staff_id":
            appointment.staff_id,

        "client_id":
            appointment.client_id,

        **totals,

        "payment_status":
            payment["status"],

        "paid_total":
            payment["paid_total"],

        "refunded_total":
            payment["refunded_total"],

        "net_paid":
            payment["net_paid"],

        "balance_due":
            payment["balance_due"],

        "payments":
            payment["payments"],

        "refunded_total":
            payment["refunded_total"],

        "net_paid":
            payment["net_paid"],

        "refunded_service":
            refunded_service,

        "refunded_tip":
            refunded_tip,

        "refunded_sale_ids":
            refunded_sale_ids,

        "refunds":
            refund_history,
    }


# =========================================================
# PUBLIC ONLINE BOOKING DEPOSIT CHECKOUT
# =========================================================

@router.post(
    "/public-deposit-checkout"
)
def create_public_deposit_checkout(
    appointment_id: int,
    booking_token: str,
    request: Request = None,
    db: Session = Depends(get_db),
):
    """
    Public Stripe Checkout for an online-booking deposit.

    No staff login is required.

    Access is protected by the random booking_token that
    belongs to the appointment.
    """

    if not STRIPE_SECRET_KEY:
        raise HTTPException(
            status_code=500,
            detail=(
                "Stripe is not configured "
                "(missing STRIPE_SECRET_KEY)."
            ),
        )


    appointment = (
        db.query(models.Appointment)
        .filter(
            models.Appointment.id
            == appointment_id
        )
        .first()
    )


    if not appointment:
        raise HTTPException(
            status_code=404,
            detail="Appointment not found.",
        )


    # -----------------------------------------------------
    # VERIFY PUBLIC BOOKING TOKEN
    # -----------------------------------------------------

    if (
        not appointment.booking_token
        or not booking_token
        or appointment.booking_token
        != booking_token
    ):
        raise HTTPException(
            status_code=403,
            detail="Invalid booking token.",
        )


    # -----------------------------------------------------
    # VERIFY THIS IS AN ONLINE DEPOSIT BOOKING
    # -----------------------------------------------------

    if appointment.booking_source != "online":
        raise HTTPException(
            status_code=400,
            detail=(
                "This appointment is not an "
                "online booking."
            ),
        )


    if not appointment.deposit_required:
        raise HTTPException(
            status_code=400,
            detail=(
                "This booking does not require "
                "a deposit."
            ),
        )


    # -----------------------------------------------------
    # ALREADY CONFIRMED?
    # -----------------------------------------------------

    if appointment.booking_status == "confirmed":

        paid_payment = (
            db.query(models.Payment)
            .filter(
                models.Payment.appointment_id
                == appointment.id,
                models.Payment.status
                == "paid",
            )
            .first()
        )

        if paid_payment:
            raise HTTPException(
                status_code=409,
                detail=(
                    "This booking deposit has "
                    "already been paid."
                ),
            )


    if appointment.booking_status != "pending_deposit":
        raise HTTPException(
            status_code=409,
            detail=(
                "This booking is no longer "
                "waiting for a deposit."
            ),
        )


    # -----------------------------------------------------
    # VERIFY HOLD HAS NOT EXPIRED
    # -----------------------------------------------------

    if (
        appointment.deposit_expires_at
        and datetime.now()
        >= appointment.deposit_expires_at
    ):

        appointment.booking_status = (
            "cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )

        db.commit()

        raise HTTPException(
            status_code=410,
            detail=(
                "This booking hold expired. "
                "Please choose the appointment "
                "time again."
            ),
        )


    # -----------------------------------------------------
    # DEPOSIT AMOUNT
    # -----------------------------------------------------

    deposit_amount = round(
        float(
            appointment.deposit_amount
            or 0.0
        ),
        2,
    )


    deposit_cents = int(
        round(
            deposit_amount * 100
        )
    )


    if deposit_cents <= 0:
        raise HTTPException(
            status_code=400,
            detail=(
                "This appointment has an invalid "
                "deposit amount."
            ),
        )


    # -----------------------------------------------------
    # PREVENT A SECOND ACTIVE DEPOSIT SESSION
    # -----------------------------------------------------

    pending_payment = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "pending",
        )
        .first()
    )


    if pending_payment:
        raise HTTPException(
            status_code=409,
            detail=(
                "A deposit checkout is already "
                "in progress for this booking."
            ),
        )


    # -----------------------------------------------------
    # CREATE PAYMENT RECORD
    # -----------------------------------------------------

    payment = models.Payment(
        appointment_id=
            appointment.id,

        amount=
            deposit_amount,

        tip_amount=
            0.0,

        method=
            "card",

        status=
            "pending",
    )


    db.add(payment)
    db.commit()
    db.refresh(payment)


    # -----------------------------------------------------
    # RETURN URL
    # -----------------------------------------------------

    origin = None


    if request:
        origin = request.headers.get(
            "origin"
        )


    if (
        not origin
        or ":8000" in origin
    ):
        origin = FRONTEND_URL


    success_url = (
        f"{origin}"
        f"?deposit_payment=success"
        f"&appointment_id={appointment.id}"
        f"&payment_id={payment.id}"
        f"&booking_token={booking_token}"
        f"&session_id={{CHECKOUT_SESSION_ID}}"
    )


    cancel_url = (
        f"{origin}"
        f"?deposit_payment=cancelled"
        f"&appointment_id={appointment.id}"
        f"&payment_id={payment.id}"
        f"&booking_token={booking_token}"
    )


    # -----------------------------------------------------
    # CREATE STRIPE SESSION
    # -----------------------------------------------------

    try:

        session = (
            stripe.checkout.Session.create(
                mode=
                    "payment",

                success_url=
                    success_url,

                cancel_url=
                    cancel_url,

                line_items=[
                    {
                        "price_data": {
                            "currency":
                                "usd",

                            "product_data": {
                                "name": (
                                    "Booking Deposit — "
                                    + (
                                        appointment.service_name
                                        or "Salon Service"
                                    )
                                ),
                            },

                            "unit_amount":
                                deposit_cents,
                        },

                        "quantity":
                            1,
                    }
                ],

                client_reference_id=
                    str(
                        appointment.id
                    ),

                metadata={
                    "appointment_id":
                        str(
                            appointment.id
                        ),

                    "staff_id":
                        str(
                            appointment.staff_id
                        ),

                    "payment_id":
                        str(
                            payment.id
                        ),

                    "payment_kind":
                        "deposit",

                    "tip_cents":
                        "0",
                },

                payment_intent_data={
                    "metadata": {
                        "appointment_id":
                            str(
                                appointment.id
                            ),

                        "staff_id":
                            str(
                                appointment.staff_id
                            ),

                        "payment_id":
                            str(
                                payment.id
                            ),

                        "payment_kind":
                            "deposit",

                        "tip_cents":
                            "0",
                    }
                },

                automatic_tax={
                    "enabled":
                        False
                },
            )
        )


        payment.stripe_checkout_session_id = (
            session.id
        )

        db.commit()


        return {
            "id":
                session.id,

            "url":
                session.url,

            "payment_id":
                payment.id,

            "appointment_id":
                appointment.id,

            "booking_status":
                appointment.booking_status,

            "deposit_amount":
                deposit_amount,

            "deposit_expires_at":
                (
                    appointment
                    .deposit_expires_at
                    .isoformat()
                    if appointment.deposit_expires_at
                    else None
                ),
        }


    except stripe.error.StripeError as e:

        payment.status = (
            "cancelled"
        )

        db.commit()


        message = (
            getattr(
                e,
                "user_message",
                None,
            )
            or str(e)
        )


        raise HTTPException(
            status_code=400,
            detail=message,
        )


    except Exception as e:

        payment.status = (
            "cancelled"
        )

        db.commit()


        raise HTTPException(
            status_code=500,
            detail=(
                f"Deposit checkout error: "
                f"{str(e)}"
            ),
        )



# =========================================================
# CREATE STRIPE CARD CHECKOUT SESSION
# =========================================================

@router.post(
    "/checkout-session"
)
def create_checkout_session(
    appointment_id: int,
    tip_cents: int = 0,
    request: Request = None,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    if not STRIPE_SECRET_KEY:
        raise HTTPException(
            status_code=500,
            detail=(
                "Stripe is not configured "
                "(missing STRIPE_SECRET_KEY)."
            ),
        )


    _validate_tip(
        tip_cents
    )


    appointment = _get_appointment(
        appointment_id,
        db,
    )


    _authorize_appointment(
        appointment,
        current_user,
    )


    totals = _build_totals(
        appointment,
        db,
        tip_cents,
    )


    existing_payment = _payment_status(
        appointment.id,
        totals["grand_total"],
        db,
    )


    amount_due_now = round(
        max(
            0.0,
            totals["grand_total"]
            - existing_payment["paid_total"],
        ),
        2,
    )


    if amount_due_now <= 0:
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment is already "
                "fully paid."
            ),
        )


    # =====================================================
    # STRIPE LINE ITEMS
    # =====================================================

    amount_due_cents = int(
        round(
            amount_due_now
            * 100
        )
    )


    if amount_due_cents <= 0:
        raise HTTPException(
            status_code=400,
            detail=(
                "There is nothing left to charge "
                "for this appointment."
            ),
        )


    line_items = [
        {
            "price_data": {
                "currency":
                    "usd",

                "product_data": {
                    "name":
                        (
                            "Remaining Balance — "
                            + (
                                appointment.service_name
                                or "Salon Appointment"
                            )
                        ),
                },

                "unit_amount":
                    amount_due_cents,
            },

            "quantity":
                1,
        }
    ]


    # =====================================================
    # RETURN URL
    # =====================================================

    origin = None


    if request:
        origin = request.headers.get(
            "origin"
        )


    # Swagger requests come from port 8000.
    # That is the backend, not the actual frontend.
    if (
        not origin
        or ":8000" in origin
    ):
        origin = FRONTEND_URL


    # =====================================================
    # CREATE PENDING PAYMENT RECORD FIRST
    # =====================================================

    payment = models.Payment(
        appointment_id=
            appointment.id,

        amount=
            amount_due_now,

        tip_amount=
            totals["tip"],

        method=
            "card",

        status=
            "pending",
    )


    db.add(payment)
    db.commit()
    db.refresh(payment)


    success_url = (
        f"{origin}"
        f"?stripe_payment=success"
        f"&appointment_id={appointment.id}"
        f"&payment_id={payment.id}"
        f"&session_id={{CHECKOUT_SESSION_ID}}"
    )


    cancel_url = (
        f"{origin}"
        f"?stripe_payment=cancelled"
        f"&appointment_id={appointment.id}"
        f"&payment_id={payment.id}"
    )


    try:
        session = (
            stripe.checkout.Session.create(
                mode=
                    "payment",

                success_url=
                    success_url,

                cancel_url=
                    cancel_url,

                line_items=
                    line_items,

                client_reference_id=
                    str(
                        appointment.id
                    ),

                metadata={
                    "appointment_id":
                        str(
                            appointment.id
                        ),

                    "staff_id":
                        str(
                            appointment.staff_id
                        ),

                    "payment_id":
                        str(
                            payment.id
                        ),

                    "tip_cents":
                        str(
                            tip_cents
                        ),
                },

                payment_intent_data={
                    "metadata": {
                        "appointment_id":
                            str(
                                appointment.id
                            ),

                        "staff_id":
                            str(
                                appointment.staff_id
                            ),

                        "payment_id":
                            str(
                                payment.id
                            ),

                        "tip_cents":
                            str(
                                tip_cents
                            ),
                    }
                },

                automatic_tax={
                    "enabled":
                        False
                },
            )
        )


        payment.stripe_checkout_session_id = (
            session.id
        )


        db.commit()


        return {
            "id":
                session.id,

            "url":
                session.url,

            "payment_id":
                payment.id,

            "appointment_id":
                appointment.id,

            "paid_before":
                existing_payment["paid_total"],

            "amount_due_now":
                amount_due_now,

            **totals,
        }


    except stripe.error.StripeError as e:

        payment.status = (
            "cancelled"
        )

        db.commit()


        message = (
            getattr(
                e,
                "user_message",
                None,
            )
            or str(e)
        )


        raise HTTPException(
            status_code=500,
            detail=(
                f"Stripe error: "
                f"{message}"
            ),
        )


    except Exception as e:

        payment.status = (
            "cancelled"
        )

        db.commit()


        raise HTTPException(
            status_code=500,
            detail=(
                f"Checkout error: "
                f"{str(e)}"
            ),
        )


