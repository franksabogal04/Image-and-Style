class RefundRequest(BaseModel):
    """
    Select exactly what should be returned.

    Examples:

        Service only:
            refund_service=True

        One product:
            sale_ids=[12]

        Service + tip:
            refund_service=True
            refund_tip=True

        Full visit:
            refund_service=True
            refund_tip=True
            sale_ids=[all sale ids]
    """

    payment_id: Optional[int] = None

    refund_service: bool = False

    refund_tip: bool = False

    sale_ids: List[int] = Field(
        default_factory=list
    )

    reason: Optional[str] = None


