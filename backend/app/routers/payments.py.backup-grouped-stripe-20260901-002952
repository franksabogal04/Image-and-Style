@router.post(
    "/cash"
)
def record_cash_payment(
    appointment_id: int,
    tip_cents: int = 0,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    _validate_tip(
        tip_cents
    )


    appointment = _get_appointment(
        appointment_id,
        db,
    )


    _authorize_appointment(
        appointment,
        current_user,
    )


    totals = _build_totals(
        appointment,
        db,
        tip_cents,
    )


    existing_payment = _payment_status(
        appointment.id,
        totals["grand_total"],
        db,
    )


    amount_due_now = round(
        max(
            0.0,
            totals["grand_total"]
            - existing_payment["paid_total"],
        ),
        2,
    )


    if amount_due_now <= 0:
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment is already "
                "fully paid."
            ),
        )


    payment = models.Payment(
        appointment_id=
            appointment.id,

        amount=
            amount_due_now,

        tip_amount=
            totals["tip"],

        method=
            "cash",

        status=
            "paid",
    )


    _update_appointment_tip(
        appointment,
        totals["tip"],
    )


    db.add(payment)

    db.commit()

    db.refresh(payment)
    db.refresh(appointment)


    return {
        "ok":
            True,

        "payment_id":
            payment.id,

        "appointment_id":
            appointment.id,

        "method":
            "cash",

        "payment_status":
            "paid",

        "amount_paid_now":
            amount_due_now,

        "previously_paid":
            existing_payment["paid_total"],

        **totals,
    }



# =========================================================
# REFUND / VOID
# =========================================================

@router.post(
    "/appointment/{appointment_id}/refund"
)
def refund_appointment_payment(
    appointment_id: int,
    payload: RefundRequest,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    """
    Refund selected parts of a completed appointment.

    Owner/receptionist only.

    Supported:
        - service
        - individual product sale rows
        - tip
        - any combination
        - full visit by selecting everything

    Card refunds are sent to Stripe.

    Cash refunds are recorded internally.

    Original Payment records remain untouched so
    accounting history is preserved.
    """

    # -----------------------------------------------------
    # PERMISSIONS
    # -----------------------------------------------------

    if current_user.role not in (
        "owner",
        "receptionist",
    ):
        raise HTTPException(
            status_code=403,
            detail=(
                "Only the owner or receptionist "
                "can issue refunds."
            ),
        )


    appointment = _get_appointment(
        appointment_id,
        db,
    )


    # -----------------------------------------------------
    # FIND ORIGINAL PAYMENTS
    # -----------------------------------------------------

    payments = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "paid",
        )
        .order_by(
            models.Payment.created_at.desc()
        )
        .all()
    )


    if not payments:
        raise HTTPException(
            status_code=404,
            detail=(
                "No completed payment was found "
                "for this appointment."
            ),
        )


    # Use the payment selected in the UI first, then
    # automatically spill any remaining refund amount
    # into the appointment's other paid transactions.
    if payload.payment_id is not None:
        selected_payment = next(
            (
                item
                for item in payments
                if item.id
                == payload.payment_id
            ),
            None,
        )

        if not selected_payment:
            raise HTTPException(
                status_code=404,
                detail=(
                    "The selected payment was not found "
                    "for this appointment."
                ),
            )

        payments = [
            selected_payment,
            *[
                item
                for item in payments
                if item.id
                != selected_payment.id
            ],
        ]


    # Kept for the existing service/tip line-building
    # logic below. The actual refund may span several
    # payment records.
    payment = payments[0]


    # -----------------------------------------------------
    # MUST SELECT SOMETHING
    # -----------------------------------------------------

    requested_sale_ids = list(
        dict.fromkeys(
            payload.sale_ids
            or []
        )
    )


    if (
        not payload.refund_service
        and not payload.refund_tip
        and not requested_sale_ids
    ):
        raise HTTPException(
            status_code=400,
            detail=(
                "Select a service, product, "
                "or tip to refund."
            ),
        )


    # -----------------------------------------------------
    # EXISTING SUCCESSFUL REFUNDS
    # -----------------------------------------------------

    previous_refunds = (
        db.query(models.Refund)
        .filter(
            models.Refund.appointment_id
            == appointment.id,
            models.Refund.status
            == "succeeded",
        )
        .all()
    )


    previous_refund_ids = [
        refund.id
        for refund in previous_refunds
    ]


    previous_lines = []

    if previous_refund_ids:
        previous_lines = (
            db.query(models.RefundLine)
            .filter(
                models.RefundLine.refund_id.in_(
                    previous_refund_ids
                )
            )
            .all()
        )


    already_refunded_service = any(
        line.kind == "service"
        for line in previous_lines
    )


    already_refunded_tip = any(
        line.kind == "tip"
        for line in previous_lines
    )


    already_refunded_sale_ids = {
        line.sale_id
        for line in previous_lines
        if (
            line.kind == "product"
            and line.sale_id is not None
        )
    }


    # -----------------------------------------------------
    # BUILD REFUND LINES
    # -----------------------------------------------------

    refund_lines = []


    # SERVICE
    if payload.refund_service:

        if already_refunded_service:
            raise HTTPException(
                status_code=409,
                detail=(
                    "The service has already "
                    "been refunded."
                ),
            )


        service_subtotal = round(
            float(
                appointment.price
                or 0.0
            ),
            2,
        )


        service_tax = round(
            float(
                appointment.service_tax_amount
                or 0.0
            ),
            2,
        )


        service_total = round(
            service_subtotal
            + service_tax,
            2,
        )


        if service_total <= 0:
            raise HTTPException(
                status_code=400,
                detail=(
                    "This appointment has no "
                    "refundable service amount."
                ),
            )


        refund_lines.append({
            "kind":
                "service",

            "sale_id":
                None,

            "staff_id":
                appointment.staff_id,

            "description":
                appointment.service_name
                or "Service",

            "quantity":
                1,

            "subtotal":
                service_subtotal,

            "tax_amount":
                service_tax,

            "total":
                service_total,
        })


    # PRODUCTS
    if requested_sale_ids:

        sales = (
            db.query(models.Sale)
            .filter(
                models.Sale.appointment_id
                == appointment.id,
                models.Sale.id.in_(
                    requested_sale_ids
                ),
            )
            .all()
        )


        found_ids = {
            sale.id
            for sale in sales
        }


        missing_ids = [
            sale_id
            for sale_id
            in requested_sale_ids
            if sale_id not in found_ids
        ]


        if missing_ids:
            raise HTTPException(
                status_code=400,
                detail=(
                    "One or more selected products "
                    "do not belong to this appointment."
                ),
            )


        duplicate_ids = [
            sale_id
            for sale_id
            in requested_sale_ids
            if sale_id
            in already_refunded_sale_ids
        ]


        if duplicate_ids:
            raise HTTPException(
                status_code=409,
                detail=(
                    "One or more selected products "
                    "have already been refunded."
                ),
            )


        for sale in sales:

            product = sale.product


            subtotal = round(
                float(
                    sale.total_price
                    or 0.0
                ),
                2,
            )


            tax_amount = round(
                float(
                    sale.retail_tax_amount
                    or 0.0
                ),
                2,
            )


            total = round(
                subtotal
                + tax_amount,
                2,
            )


            if total <= 0:
                continue


            refund_lines.append({
                "kind":
                    "product",

                "sale_id":
                    sale.id,

                "staff_id":
                    sale.staff_id,

                "description":
                    (
                        product.name
                        if product
                        else (
                            f"Product #{sale.product_id}"
                        )
                    ),

                "quantity":
                    int(
                        sale.quantity
                        or 1
                    ),

                "subtotal":
                    subtotal,

                "tax_amount":
                    tax_amount,

                "total":
                    total,
            })


    # TIP
    if payload.refund_tip:

        if already_refunded_tip:
            raise HTTPException(
                status_code=409,
                detail=(
                    "The tip has already "
                    "been refunded."
                ),
            )


        tip_subtotal = round(
            float(
                payment.tip_amount
                or appointment.tip
                or 0.0
            ),
            2,
        )


        tip_tax = round(
            float(
                appointment.tip_tax_amount
                or 0.0
            ),
            2,
        )


        tip_total = round(
            tip_subtotal
            + tip_tax,
            2,
        )


        if tip_total <= 0:
            raise HTTPException(
                status_code=400,
                detail=(
                    "This payment has no "
                    "refundable tip."
                ),
            )


        refund_lines.append({
            "kind":
                "tip",

            "sale_id":
                None,

            "staff_id":
                appointment.staff_id,

            "description":
                "Tip",

            "quantity":
                1,

            "subtotal":
                tip_subtotal,

            "tax_amount":
                tip_tax,

            "total":
                tip_total,
        })


    if not refund_lines:
        raise HTTPException(
            status_code=400,
            detail=(
                "The selected items have no "
                "refundable amount."
            ),
        )


    # -----------------------------------------------------
    # REFUND TOTAL
    # -----------------------------------------------------

    refund_total = round(
        sum(
            float(
                line["total"]
                or 0.0
            )
            for line in refund_lines
        ),
        2,
    )


    if refund_total <= 0:
        raise HTTPException(
            status_code=400,
            detail=(
                "Refund amount must be greater "
                "than zero."
            ),
        )


    # Successful amounts already returned from each
    # original payment.
    refunded_by_payment = {}

    for previous_refund in previous_refunds:
        refunded_by_payment[
            previous_refund.payment_id
        ] = round(
            refunded_by_payment.get(
                previous_refund.payment_id,
                0.0,
            )
            + float(
                previous_refund.amount
                or 0.0
            ),
            2,
        )


    payment_capacities = []

    for original_payment in payments:
        payment_amount = round(
            float(
                original_payment.amount
                or 0.0
            ),
            2,
        )

        already_returned = round(
            float(
                refunded_by_payment.get(
                    original_payment.id,
                    0.0,
                )
            ),
            2,
        )

        available = round(
            max(
                0.0,
                payment_amount
                - already_returned,
            ),
            2,
        )

        if available > 0:
            payment_capacities.append(
                (
                    original_payment,
                    available,
                )
            )


    remaining_refundable = round(
        sum(
            available
            for (
                original_payment,
                available
            )
            in payment_capacities
        ),
        2,
    )


    if (
        refund_total
        > remaining_refundable + 0.005
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "Refund amount exceeds the total "
                "remaining refundable payments."
            ),
        )


    # -----------------------------------------------------
    # ALLOCATE ACROSS ORIGINAL PAYMENTS
    # -----------------------------------------------------

    allocations = []

    amount_left = refund_total

    for (
        original_payment,
        available,
    ) in payment_capacities:
        if amount_left <= 0.005:
            break

        allocation_amount = round(
            min(
                available,
                amount_left,
            ),
            2,
        )

        if allocation_amount <= 0:
            continue

        allocations.append(
            (
                original_payment,
                allocation_amount,
            )
        )

        amount_left = round(
            amount_left
            - allocation_amount,
            2,
        )


    if amount_left > 0.005:
        raise HTTPException(
            status_code=409,
            detail=(
                "The refund could not be allocated "
                "across the original payments."
            ),
        )


    # Validate every transaction before any external
    # Stripe refund is submitted.
    for (
        original_payment,
        allocation_amount,
    ) in allocations:
        if original_payment.method not in (
            "card",
            "cash",
        ):
            raise HTTPException(
                status_code=400,
                detail=(
                    f"Unsupported payment method: "
                    f"{original_payment.method}"
                ),
            )

        if original_payment.method == "card":
            if not STRIPE_SECRET_KEY:
                raise HTTPException(
                    status_code=500,
                    detail=(
                        "Stripe is not configured "
                        "(missing STRIPE_SECRET_KEY)."
                    ),
                )

            if (
                not original_payment
                .stripe_payment_intent_id
            ):
                raise HTTPException(
                    status_code=409,
                    detail=(
                        "One of the card payments does "
                        "not have a Stripe PaymentIntent ID."
                    ),
                )


    reason = (
        payload.reason.strip()
        if (
            payload.reason
            and payload.reason.strip()
        )
        else None
    )


    refund_records = []


    for (
        original_payment,
        allocation_amount,
    ) in allocations:
        refund_record = models.Refund(
            appointment_id=
                appointment.id,

            payment_id=
                original_payment.id,

            method=
                original_payment.method,

            status=
                "pending",

            amount=
                allocation_amount,

            reason=
                reason,
        )

        db.add(
            refund_record
        )

        db.flush()

        refund_records.append(
            (
                original_payment,
                allocation_amount,
                refund_record,
            )
        )


    # Split accounting lines proportionally between
    # refund transactions. Across all records, the
    # original service/product/tip totals remain exact.
    for line_data in refund_lines:
        remaining_subtotal = round(
            float(
                line_data["subtotal"]
                or 0.0
            ),
            2,
        )

        remaining_tax = round(
            float(
                line_data["tax_amount"]
                or 0.0
            ),
            2,
        )

        remaining_line_total = round(
            float(
                line_data["total"]
                or 0.0
            ),
            2,
        )


        for index, (
            original_payment,
            allocation_amount,
            refund_record,
        ) in enumerate(
            refund_records
        ):
            is_last = (
                index
                == len(
                    refund_records
                ) - 1
            )

            if is_last:
                line_subtotal = (
                    remaining_subtotal
                )

                line_tax = (
                    remaining_tax
                )

                line_total = (
                    remaining_line_total
                )

            else:
                ratio = (
                    allocation_amount
                    / refund_total
                )

                line_subtotal = round(
                    float(
                        line_data["subtotal"]
                        or 0.0
                    )
                    * ratio,
                    2,
                )

                line_tax = round(
                    float(
                        line_data["tax_amount"]
                        or 0.0
                    )
                    * ratio,
                    2,
                )

                line_total = round(
                    float(
                        line_data["total"]
                        or 0.0
                    )
                    * ratio,
                    2,
                )


            remaining_subtotal = round(
                remaining_subtotal
                - line_subtotal,
                2,
            )

            remaining_tax = round(
                remaining_tax
                - line_tax,
                2,
            )

            remaining_line_total = round(
                remaining_line_total
                - line_total,
                2,
            )


            db.add(
                models.RefundLine(
                    refund_id=
                        refund_record.id,

                    kind=
                        line_data["kind"],

                    sale_id=
                        line_data["sale_id"],

                    staff_id=
                        line_data["staff_id"],

                    description=
                        line_data["description"],

                    quantity=
                        (
                            line_data["quantity"]
                            if index == 0
                            else None
                        ),

                    subtotal=
                        line_subtotal,

                    tax_amount=
                        line_tax,

                    total=
                        line_total,
                )
            )


    # Save the pending audit records before contacting
    # Stripe, so every attempted external refund remains
    # traceable.
    db.commit()


    # -----------------------------------------------------
    # PROCESS EACH CARD/CASH ALLOCATION
    # -----------------------------------------------------

    for (
        original_payment,
        allocation_amount,
        refund_record,
    ) in refund_records:
        try:
            if (
                original_payment.method
                == "card"
            ):
                stripe_refund = (
                    stripe.Refund.create(
                        payment_intent=
                            original_payment
                            .stripe_payment_intent_id,

                        amount=
                            int(
                                round(
                                    allocation_amount
                                    * 100
                                )
                            ),

                        metadata={
                            "appointment_id":
                                str(
                                    appointment.id
                                ),

                            "payment_id":
                                str(
                                    original_payment.id
                                ),

                            "refund_id":
                                str(
                                    refund_record.id
                                ),
                        },
                    )
                )


                stripe_status = (
                    stripe_refund.get(
                        "status"
                    )
                    or "succeeded"
                )


                if stripe_status not in (
                    "succeeded",
                    "pending",
                ):
                    refund_record.status = (
                        "failed"
                    )

                    db.commit()

                    raise HTTPException(
                        status_code=502,
                        detail=(
                            "Stripe did not complete "
                            "one of the refunds."
                        ),
                    )


                refund_record.stripe_refund_id = (
                    stripe_refund.get(
                        "id"
                    )
                )

                refund_record.status = (
                    "succeeded"
                    if stripe_status
                    == "succeeded"
                    else "pending"
                )


            else:
                # Cash was physically returned.
                refund_record.status = (
                    "succeeded"
                )


            db.commit()
            db.refresh(
                refund_record
            )


        except HTTPException:
            raise


        except stripe.error.StripeError as error:
            refund_record.status = (
                "failed"
            )

            db.commit()

            message = (
                getattr(
                    error,
                    "user_message",
                    None,
                )
                or str(
                    error
                )
            )

            raise HTTPException(
                status_code=502,
                detail=(
                    f"Stripe refund error: "
                    f"{message}"
                ),
            )


        except Exception as error:
            refund_record.status = (
                "failed"
            )

            db.commit()

            raise HTTPException(
                status_code=500,
                detail=(
                    f"Refund error: "
                    f"{str(error)}"
                ),
            )


    statuses = [
        refund_record.status
        for (
            original_payment,
            allocation_amount,
            refund_record
        )
        in refund_records
    ]


    overall_status = (
        "succeeded"
        if all(
            status == "succeeded"
            for status in statuses
        )
        else "pending"
    )


    return {
        "ok":
            True,

        "refund_id":
            refund_records[0][2].id,

        "refund_ids":
            [
                refund_record.id
                for (
                    original_payment,
                    allocation_amount,
                    refund_record
                )
                in refund_records
            ],

        "appointment_id":
            appointment.id,

        "payment_id":
            refund_records[0][0].id,

        "payment_ids":
            [
                original_payment.id
                for (
                    original_payment,
                    allocation_amount,
                    refund_record
                )
                in refund_records
            ],

        "method":
            (
                refund_records[0][0].method
                if len(
                    {
                        original_payment.method
                        for (
                            original_payment,
                            allocation_amount,
                            refund_record
                        )
                        in refund_records
                    }
                ) == 1
                else "multiple"
            ),

        "status":
            overall_status,

        "refund_total":
            refund_total,

        "remaining_refundable":
            round(
                max(
                    0.0,
                    remaining_refundable
                    - refund_total,
                ),
                2,
            ),

        "lines":
            refund_lines,
    }


# =========================================================
# PUBLIC ONLINE BOOKING CANCELLATION
# =========================================================

@router.post(
    "/public-cancel-booking"
)
def public_cancel_booking(
    appointment_id: int,
    booking_token: str,
    db: Session = Depends(get_db),
):
    """
    Customer cancellation for an online booking.

    Policy:
      - More than 1 hour before appointment:
        refund the deposit.
      - 1 hour or less before appointment:
        retain the deposit.
    """

    appointment = (
        db.query(models.Appointment)
        .filter(
            models.Appointment.id
            == appointment_id
        )
        .first()
    )


    if not appointment:
        raise HTTPException(
            status_code=404,
            detail="Booking not found.",
        )


    # -----------------------------------------------------
    # SECURITY
    # -----------------------------------------------------

    if (
        not appointment.booking_token
        or not booking_token
        or appointment.booking_token
        != booking_token
    ):
        raise HTTPException(
            status_code=403,
            detail="Invalid booking token.",
        )


    if appointment.booking_source != "online":
        raise HTTPException(
            status_code=400,
            detail=(
                "This is not an online booking."
            ),
        )


    # -----------------------------------------------------
    # ALREADY CANCELLED
    # -----------------------------------------------------

    if appointment.booking_status in (
        "cancelled",
        "late_cancelled",
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "This booking has already "
                "been cancelled."
            ),
        )


    # -----------------------------------------------------
    # UNPAID PENDING BOOKING
    # -----------------------------------------------------

    if (
        appointment.booking_status
        == "pending_deposit"
    ):

        appointment.booking_status = (
            "cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )

        pending_payments = (
            db.query(models.Payment)
            .filter(
                models.Payment.appointment_id
                == appointment.id,
                models.Payment.status
                == "pending",
            )
            .all()
        )


        for payment in pending_payments:
            payment.status = (
                "cancelled"
            )


        db.commit()


        return {
            "ok":
                True,

            "appointment_id":
                appointment.id,

            "booking_status":
                "cancelled",

            "deposit_refunded":
                False,

            "deposit_retained":
                False,

            "refund_amount":
                0.0,

            "message":
                (
                    "Booking cancelled. "
                    "No deposit had been paid."
                ),
        }


    # -----------------------------------------------------
    # FIND PAID DEPOSIT PAYMENT
    # -----------------------------------------------------

    deposit_amount = round(
        float(
            appointment.deposit_amount
            or 0.0
        ),
        2,
    )


    paid_payments = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "paid",
        )
        .order_by(
            models.Payment.created_at.asc()
        )
        .all()
    )


    deposit_payment = None


    for payment in paid_payments:

        payment_amount = round(
            float(
                payment.amount
                or 0.0
            ),
            2,
        )

        if (
            abs(
                payment_amount
                - deposit_amount
            )
            <= 0.01
        ):
            deposit_payment = (
                payment
            )

            break


    if not deposit_payment:
        raise HTTPException(
            status_code=409,
            detail=(
                "A completed deposit payment "
                "could not be found."
            ),
        )


    # -----------------------------------------------------
    # CANCELLATION WINDOW
    # -----------------------------------------------------

    now = datetime.now()


    if not appointment.start_time:
        raise HTTPException(
            status_code=400,
            detail=(
                "Appointment start time "
                "is missing."
            ),
        )


    seconds_until_appointment = (
        appointment.start_time
        - now
    ).total_seconds()


    more_than_one_hour = (
        seconds_until_appointment
        > 3600
    )


    # =====================================================
    # LATE CANCELLATION
    # DEPOSIT IS RETAINED
    # =====================================================

    if not more_than_one_hour:

        appointment.booking_status = (
            "late_cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )


        db.commit()


        return {
            "ok":
                True,

            "appointment_id":
                appointment.id,

            "booking_status":
                "late_cancelled",

            "deposit_refunded":
                False,

            "deposit_retained":
                True,

            "refund_amount":
                0.0,

            "deposit_amount":
                deposit_amount,

            "message":
                (
                    "Booking cancelled within "
                    "1 hour of the appointment. "
                    "The deposit was retained."
                ),
        }


    # =====================================================
    # EARLY CANCELLATION
    # REFUND DEPOSIT
    # =====================================================

    previous_deposit_refund = (
        db.query(models.RefundLine)
        .join(
            models.Refund,
            models.Refund.id
            == models.RefundLine.refund_id
        )
        .filter(
            models.Refund.appointment_id
            == appointment.id,
            models.Refund.payment_id
            == deposit_payment.id,
            models.Refund.status.in_(
                (
                    "pending",
                    "succeeded",
                )
            ),
            models.RefundLine.kind
            == "deposit",
        )
        .first()
    )


    if previous_deposit_refund:
        raise HTTPException(
            status_code=409,
            detail=(
                "This deposit has already "
                "been refunded."
            ),
        )


    refund_amount = round(
        float(
            deposit_payment.amount
            or 0.0
        ),
        2,
    )


    if refund_amount <= 0:
        raise HTTPException(
            status_code=400,
            detail=(
                "Deposit refund amount is invalid."
            ),
        )


    refund = models.Refund(
        appointment_id=
            appointment.id,

        payment_id=
            deposit_payment.id,

        method=
            deposit_payment.method,

        status=
            "pending",

        amount=
            refund_amount,

        reason=
            "Online booking cancelled more than 1 hour before appointment.",
    )


    db.add(refund)
    db.flush()


    refund_line = models.RefundLine(
        refund_id=
            refund.id,

        kind=
            "deposit",

        sale_id=
            None,

        staff_id=
            appointment.staff_id,

        description=
            "Booking Deposit",

        quantity=
            1,

        subtotal=
            refund_amount,

        tax_amount=
            0.0,

        total=
            refund_amount,
    )


    db.add(refund_line)
    db.flush()


    # -----------------------------------------------------
    # PROCESS REFUND
    # -----------------------------------------------------

    try:

        if deposit_payment.method != "card":
            raise HTTPException(
                status_code=400,
                detail=(
                    "Online deposit payment "
                    "is not a card payment."
                ),
            )


        if not STRIPE_SECRET_KEY:
            raise HTTPException(
                status_code=500,
                detail=(
                    "Stripe is not configured "
                    "(missing STRIPE_SECRET_KEY)."
                ),
            )


        if (
            not deposit_payment
            .stripe_payment_intent_id
        ):
            raise HTTPException(
                status_code=409,
                detail=(
                    "Deposit payment does not "
                    "have a Stripe PaymentIntent ID."
                ),
            )


        stripe_refund = (
            stripe.Refund.create(
                payment_intent=
                    deposit_payment
                    .stripe_payment_intent_id,

                amount=
                    int(
                        round(
                            refund_amount
                            * 100
                        )
                    ),

                metadata={
                    "appointment_id":
                        str(
                            appointment.id
                        ),

                    "payment_id":
                        str(
                            deposit_payment.id
                        ),

                    "refund_id":
                        str(
                            refund.id
                        ),

                    "refund_kind":
                        "deposit",
                },
            )
        )


        stripe_status = (
            stripe_refund.get(
                "status"
            )
            or "succeeded"
        )


        if stripe_status not in (
            "succeeded",
            "pending",
        ):

            refund.status = (
                "failed"
            )

            db.commit()

            raise HTTPException(
                status_code=502,
                detail=(
                    "Stripe did not complete "
                    "the deposit refund."
                ),
            )


        refund.stripe_refund_id = (
            stripe_refund.get(
                "id"
            )
        )


        refund.status = (
            "succeeded"
            if stripe_status
            == "succeeded"
            else "pending"
        )


        appointment.booking_status = (
            "cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )


        db.commit()
        db.refresh(refund)


    except HTTPException:

        db.rollback()
        raise


    except stripe.error.StripeError as e:

        db.rollback()

        message = (
            getattr(
                e,
                "user_message",
                None,
            )
            or str(e)
        )

        raise HTTPException(
            status_code=502,
            detail=(
                f"Stripe deposit refund error: "
                f"{message}"
            ),
        )


    except Exception as e:

        db.rollback()

        raise HTTPException(
            status_code=500,
            detail=(
                f"Deposit cancellation error: "
                f"{str(e)}"
            ),
        )


    return {
        "ok":
            True,

        "appointment_id":
            appointment.id,

        "booking_status":
            "cancelled",

        "deposit_refunded":
            True,

        "deposit_retained":
            False,

        "refund_id":
            refund.id,

        "refund_status":
            refund.status,

        "refund_amount":
            refund_amount,

        "message":
            (
                "Booking cancelled and "
                "deposit refund submitted."
            ),
    }



