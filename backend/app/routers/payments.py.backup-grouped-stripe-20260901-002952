def _complete_moto_deposit(
    appointment,
    payment,
    db: Session,
):
    payment.status = "paid"
    payment.method = "card"

    appointment.booking_status = (
        "confirmed"
    )

    appointment.deposit_expires_at = (
        None
    )

    db.commit()
    db.refresh(payment)
    db.refresh(appointment)

    email_result = (
        send_booking_confirmation_email(
            db,
            appointment,
        )
    )

    if not email_result.get(
        "sent"
    ):
        print(
            "Phone booking confirmation email:",
            email_result,
        )


@router.post(
    "/appointment/{appointment_id}"
    "/moto-deposit/start"
)
def start_moto_deposit(
    appointment_id: int,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    appointment = _get_appointment(
        appointment_id,
        db,
    )

    _authorize_appointment(
        appointment,
        current_user,
    )

    if appointment.booking_status == "confirmed":
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment is already confirmed."
            ),
        )

    if appointment.booking_status in (
        "cancelled",
        "late_cancelled",
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment has been cancelled."
            ),
        )

    if not appointment.deposit_required:
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment does not require "
                "a deposit."
            ),
        )

    deposit_amount = round(
        float(
            appointment.deposit_amount
            or 0.0
        ),
        2,
    )

    if deposit_amount <= 0:
        raise HTTPException(
            status_code=400,
            detail=(
                "The appointment deposit amount "
                "is invalid."
            ),
        )

    if not STRIPE_SECRET_KEY:
        raise HTTPException(
            status_code=500,
            detail=(
                "Stripe is not configured."
            ),
        )

    if not STRIPE_TERMINAL_READER_ID:
        raise HTTPException(
            status_code=500,
            detail=(
                "STRIPE_TERMINAL_READER_ID "
                "is not configured."
            ),
        )

    paid_deposit = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "paid",
        )
        .first()
    )

    if paid_deposit:
        _complete_moto_deposit(
            appointment,
            paid_deposit,
            db,
        )

        return {
            "ok": True,
            "appointment_id":
                appointment.id,
            "payment_id":
                paid_deposit.id,
            "payment_status":
                "paid",
            "booking_status":
                "confirmed",
            "deposit_amount":
                deposit_amount,
        }

    pending_payment = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "pending",
            models.Payment
            .stripe_payment_intent_id
            .isnot(None),
        )
        .order_by(
            models.Payment.created_at.desc()
        )
        .first()
    )

    if pending_payment:
        try:
            existing_intent = (
                stripe.PaymentIntent.retrieve(
                    pending_payment
                    .stripe_payment_intent_id
                )
            )

            existing_status = (
                existing_intent.get(
                    "status"
                )
            )

            if existing_status == "succeeded":
                _complete_moto_deposit(
                    appointment,
                    pending_payment,
                    db,
                )

                return {
                    "ok": True,
                    "appointment_id":
                        appointment.id,
                    "payment_id":
                        pending_payment.id,
                    "payment_status":
                        "paid",
                    "booking_status":
                        "confirmed",
                    "deposit_amount":
                        deposit_amount,
                }

            return {
                "ok": True,
                "already_started": True,
                "appointment_id":
                    appointment.id,
                "payment_id":
                    pending_payment.id,
                "payment_intent_id":
                    pending_payment
                    .stripe_payment_intent_id,
                "payment_status":
                    existing_status
                    or "pending",
                "booking_status":
                    appointment.booking_status,
                "deposit_amount":
                    deposit_amount,
                "reader_id":
                    STRIPE_TERMINAL_READER_ID,
            }

        except stripe.error.StripeError:
            pending_payment.status = (
                "cancelled"
            )

            db.commit()

    payment = models.Payment(
        appointment_id=
            appointment.id,

        amount=
            deposit_amount,

        tip_amount=
            0.0,

        method=
            "card",

        status=
            "pending",
    )

    db.add(payment)
    db.flush()

    payment_intent = None

    try:
        payment_intent = (
            stripe.PaymentIntent.create(
                amount=
                    int(
                        round(
                            deposit_amount
                            * 100
                        )
                    ),

                currency=
                    "usd",

                payment_method_types=(
                    [
                        "card_present",
                    ]
                    if STRIPE_MOTO_SIMULATION
                    else [
                        "card",
                    ]
                ),

                capture_method=
                    "automatic",

                description=(
                    "Image & Style phone "
                    f"booking deposit "
                    f"for appointment "
                    f"#{appointment.id}"
                ),

                metadata={
                    "appointment_id":
                        str(
                            appointment.id
                        ),

                    "payment_id":
                        str(
                            payment.id
                        ),

                    "payment_kind":
                        "moto_deposit",
                },
            )
        )

        payment.stripe_payment_intent_id = (
            payment_intent.id
        )

        db.commit()
        db.refresh(payment)

        reader_parameters = {
            "payment_intent":
                payment_intent.id,
        }

        if not STRIPE_MOTO_SIMULATION:
            reader_parameters[
                "process_config"
            ] = {
                "moto":
                    True,
            }

        reader = (
            stripe.terminal.Reader
            .process_payment_intent(
                STRIPE_TERMINAL_READER_ID,
                **reader_parameters,
            )
        )

        # Server-driven simulated readers have no UI.
        # Present Stripe's default successful test card.
        if STRIPE_MOTO_SIMULATION:
            simulator_response = (
                requests.post(
                    (
                        "https://api.stripe.com/v1/"
                        "test_helpers/terminal/readers/"
                        f"{STRIPE_TERMINAL_READER_ID}/"
                        "present_payment_method"
                    ),
                    auth=(
                        STRIPE_SECRET_KEY,
                        "",
                    ),
                    timeout=30,
                )
            )

            if not simulator_response.ok:
                raise RuntimeError(
                    "Stripe simulator error: "
                    + simulator_response.text
                )

            reader = (
                simulator_response.json()
            )

            simulated_intent = (
                stripe.PaymentIntent.retrieve(
                    payment_intent.id
                )
            )

            if (
                simulated_intent.status
                == "requires_capture"
            ):
                simulated_intent = (
                    stripe.PaymentIntent.capture(
                        simulated_intent.id
                    )
                )

            if (
                simulated_intent.status
                == "succeeded"
            ):
                _complete_moto_deposit(
                    appointment,
                    payment,
                    db,
                )

    except stripe.error.StripeError as error:
        db.rollback()

        stored_payment = (
            db.query(models.Payment)
            .filter(
                models.Payment.id
                == payment.id
            )
            .first()
        )

        if stored_payment:
            stored_payment.status = (
                "cancelled"
            )

            db.commit()

        message = (
            getattr(
                error,
                "user_message",
                None,
            )
            or str(error)
        )

        raise HTTPException(
            status_code=502,
            detail=(
                "Stripe MOTO deposit error: "
                f"{message}"
            ),
        )

    except Exception as error:
        db.rollback()

        raise HTTPException(
            status_code=500,
            detail=(
                "MOTO deposit error: "
                f"{str(error)}"
            ),
        )

    reader_action = (
        reader.get("action")
        or {}
    )

    return {
        "ok":
            True,

        "appointment_id":
            appointment.id,

        "payment_id":
            payment.id,

        "payment_intent_id":
            payment_intent.id,

        "payment_status":
            payment_intent.get(
                "status"
            ),

        "booking_status":
            appointment.booking_status,

        "deposit_amount":
            deposit_amount,

        "reader_id":
            reader.get(
                "id"
            ),

        "reader_status":
            reader.get(
                "status"
            ),

        "reader_action_status":
            reader_action.get(
                "status"
            ),
    }


@router.get(
    "/appointment/{appointment_id}"
    "/moto-deposit/status"
)
def moto_deposit_status(
    appointment_id: int,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    appointment = _get_appointment(
        appointment_id,
        db,
    )

    _authorize_appointment(
        appointment,
        current_user,
    )

    payment = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment
            .stripe_payment_intent_id
            .isnot(None),
        )
        .order_by(
            models.Payment.created_at.desc()
        )
        .first()
    )

    if not payment:
        raise HTTPException(
            status_code=404,
            detail=(
                "No MOTO deposit payment "
                "was found."
            ),
        )

    try:
        payment_intent = (
            stripe.PaymentIntent.retrieve(
                payment
                .stripe_payment_intent_id
            )
        )

        intent_status = (
            payment_intent.get(
                "status"
            )
            or "pending"
        )

        if intent_status == "requires_capture":
            payment_intent = (
                stripe.PaymentIntent.capture(
                    payment_intent.id
                )
            )

            intent_status = (
                payment_intent.get(
                    "status"
                )
                or intent_status
            )

        if intent_status == "succeeded":
            _complete_moto_deposit(
                appointment,
                payment,
                db,
            )

            return {
                "ok":
                    True,

                "complete":
                    True,

                "appointment_id":
                    appointment.id,

                "payment_id":
                    payment.id,

                "payment_status":
                    "paid",

                "booking_status":
                    "confirmed",

                "deposit_amount":
                    round(
                        float(
                            payment.amount
                            or 0.0
                        ),
                        2,
                    ),
            }

        reader = (
            stripe.terminal.Reader.retrieve(
                STRIPE_TERMINAL_READER_ID
            )
        )

        action = (
            reader.get("action")
            or {}
        )

        action_status = (
            action.get(
                "status"
            )
        )

        failure_message = (
            action.get(
                "failure_message"
            )
        )

        if (
            action_status == "failed"
            or intent_status == "canceled"
        ):
            payment.status = (
                "cancelled"
            )

            db.commit()

            return {
                "ok":
                    False,

                "complete":
                    False,

                "appointment_id":
                    appointment.id,

                "payment_id":
                    payment.id,

                "payment_status":
                    intent_status,

                "booking_status":
                    appointment.booking_status,

                "reader_action_status":
                    action_status,

                "error":
                    failure_message
                    or (
                        "The MOTO deposit "
                        "was not completed."
                    ),
            }

        return {
            "ok":
                True,

            "complete":
                False,

            "appointment_id":
                appointment.id,

            "payment_id":
                payment.id,

            "payment_status":
                intent_status,

            "booking_status":
                appointment.booking_status,

            "reader_status":
                reader.get(
                    "status"
                ),

            "reader_action_status":
                action_status,

            "deposit_amount":
                round(
                    float(
                        payment.amount
                        or 0.0
                    ),
                    2,
                ),
        }

    except stripe.error.StripeError as error:
        message = (
            getattr(
                error,
                "user_message",
                None,
            )
            or str(error)
        )

        raise HTTPException(
            status_code=502,
            detail=(
                "Stripe MOTO status error: "
                f"{message}"
            ),
        )



