@router.post(
    "/webhook"
)
async def stripe_webhook(
    request: Request,
    db: Session = Depends(get_db),
):
    if not STRIPE_WEBHOOK_SECRET:

        return JSONResponse(
            status_code=500,

            content={
                "error": (
                    "Webhook not configured "
                    "(STRIPE_WEBHOOK_SECRET missing)."
                )
            },
        )


    payload = await request.body()


    sig_header = request.headers.get(
        "stripe-signature"
    )


    if not sig_header:

        return JSONResponse(
            status_code=400,

            content={
                "error":
                    "Missing Stripe signature."
            },
        )


    try:

        event = (
            stripe.Webhook.construct_event(
                payload=
                    payload,

                sig_header=
                    sig_header,

                secret=
                    STRIPE_WEBHOOK_SECRET,
            )
        )


    except (
        stripe.error
        .SignatureVerificationError
    ):

        return JSONResponse(
            status_code=400,

            content={
                "error":
                    "Invalid Stripe signature."
            },
        )


    except Exception as e:

        return JSONResponse(
            status_code=400,

            content={
                "error":
                    str(e)
            },
        )


    # =====================================================
    # MOTO DEPOSIT COMPLETED
    # =====================================================

    if (
        event["type"]
        == "payment_intent.succeeded"
    ):
        intent = (
            event["data"]["object"]
        )

        metadata = (
            intent.get("metadata")
            or {}
        )

        if (
            metadata.get(
                "payment_kind"
            )
            == "moto_deposit"
        ):
            try:
                appointment_id = int(
                    metadata.get(
                        "appointment_id"
                    )
                )

                payment_id = int(
                    metadata.get(
                        "payment_id"
                    )
                )

            except (
                TypeError,
                ValueError,
            ):
                return JSONResponse(
                    status_code=400,
                    content={
                        "error":
                            "Invalid MOTO metadata."
                    },
                )

            appointment = (
                db.query(
                    models.Appointment
                )
                .filter(
                    models.Appointment.id
                    == appointment_id
                )
                .first()
            )

            payment = (
                db.query(
                    models.Payment
                )
                .filter(
                    models.Payment.id
                    == payment_id,
                    models.Payment
                    .appointment_id
                    == appointment_id,
                )
                .first()
            )

            if not appointment or not payment:
                return JSONResponse(
                    status_code=404,
                    content={
                        "error":
                            "MOTO appointment or "
                            "payment not found."
                    },
                )

            payment.stripe_payment_intent_id = (
                intent.get("id")
            )

            _complete_moto_deposit(
                appointment,
                payment,
                db,
            )

            return {
                "received":
                    True,

                "appointment_id":
                    appointment.id,

                "payment_id":
                    payment.id,

                "payment_status":
                    "paid",

                "booking_status":
                    "confirmed",

                "payment_kind":
                    "moto_deposit",
            }



    # =====================================================
    # CHECKOUT COMPLETED
    # =====================================================

    if (
        event["type"]
        == "checkout.session.completed"
    ):

        session = (
            event["data"]["object"]
        )


        payment_status = (
            session.get(
                "payment_status"
            )
        )


        if payment_status != "paid":

            return {
                "received":
                    True,

                "payment_status":
                    payment_status,
            }


        metadata = (
            session.get(
                "metadata"
            )
            or {}
        )


        appointment_id_raw = (
            metadata.get(
                "appointment_id"
            )
        )


        payment_id_raw = (
            metadata.get(
                "payment_id"
            )
        )


        tip_cents_raw = (
            metadata.get(
                "tip_cents",
                "0",
            )
        )


        payment_kind = (
            metadata.get(
                "payment_kind",
                "checkout",
            )
        )


        if (
            not appointment_id_raw
            or not payment_id_raw
        ):

            return JSONResponse(
                status_code=400,

                content={
                    "error": (
                        "Missing appointment_id "
                        "or payment_id metadata."
                    )
                },
            )


        try:

            appointment_id = int(
                appointment_id_raw
            )


            payment_id = int(
                payment_id_raw
            )


            tip_cents = int(
                tip_cents_raw
            )


        except (
            TypeError,
            ValueError,
        ):

            return JSONResponse(
                status_code=400,

                content={
                    "error":
                        "Invalid payment metadata."
                },
            )


        appointment = (
            db.query(
                models.Appointment
            )
            .filter(
                models.Appointment.id
                == appointment_id
            )
            .first()
        )


        payment = (
            db.query(
                models.Payment
            )
            .filter(
                models.Payment.id
                == payment_id
            )
            .first()
        )


        if not appointment:

            return JSONResponse(
                status_code=404,

                content={
                    "error":
                        "Appointment not found."
                },
            )


        if not payment:

            return JSONResponse(
                status_code=404,

                content={
                    "error":
                        "Payment record not found."
                },
            )


        tip_amount = round(
            tip_cents
            / 100.0,
            2,
        )


        # Idempotent:
        # receiving the same webhook twice does NOT
        # create another payment or double the tip.

        payment.status = (
            "paid"
        )


        payment.method = (
            "card"
        )


        payment.tip_amount = (
            tip_amount
        )


        payment.stripe_checkout_session_id = (
            session.get("id")
        )


        payment.stripe_payment_intent_id = (
            session.get(
                "payment_intent"
            )
        )


        if payment_kind == "deposit":

            # Deposit confirms an online booking.
            # It is NOT a tip and should not change
            # the appointment tip amount.

            appointment.booking_status = (
                "confirmed"
            )

            appointment.deposit_expires_at = (
                None
            )

        else:

            _update_appointment_tip(
                appointment,
                tip_amount,
            )


        db.commit()


        if payment_kind == "deposit":
            email_result = (
                send_booking_confirmation_email(
                    db,
                    appointment,
                )
            )

            if not email_result.get(
                "sent"
            ):
                print(
                    "Booking confirmation email:",
                    email_result,
                )


        return {
            "received":
                True,

            "appointment_id":
                appointment.id,

            "payment_id":
                payment.id,

            "payment_status":
                "paid",

            "method":
                "card",

            "payment_kind":
                payment_kind,

            "tip":
                tip_amount,
        }


    # =====================================================
    # CHECKOUT EXPIRED
    # =====================================================

    if (
        event["type"]
        == "checkout.session.expired"
    ):

        session = (
            event["data"]["object"]
        )


        metadata = (
            session.get(
                "metadata"
            )
            or {}
        )


        payment_id_raw = (
            metadata.get(
                "payment_id"
            )
        )


        appointment_id_raw = (
            metadata.get(
                "appointment_id"
            )
        )


        payment_kind = (
            metadata.get(
                "payment_kind",
                "checkout",
            )
        )


        if payment_id_raw:

            try:

                payment_id = int(
                    payment_id_raw
                )


                payment = (
                    db.query(
                        models.Payment
                    )
                    .filter(
                        models.Payment.id
                        == payment_id
                    )
                    .first()
                )


                if (
                    payment
                    and payment.status
                    == "pending"
                ):

                    payment.status = (
                        "cancelled"
                    )


                    # If this was an online deposit checkout
                    # that expired before payment, release
                    # the temporary appointment hold.

                    if (
                        payment_kind
                        == "deposit"
                        and appointment_id_raw
                    ):

                        try:

                            appointment_id = int(
                                appointment_id_raw
                            )


                            appointment = (
                                db.query(
                                    models.Appointment
                                )
                                .filter(
                                    models.Appointment.id
                                    == appointment_id
                                )
                                .first()
                            )


                            if (
                                appointment
                                and appointment.booking_status
                                == "pending_deposit"
                            ):

                                appointment.booking_status = (
                                    "cancelled"
                                )

                                appointment.deposit_expires_at = (
                                    None
                                )


                        except (
                            TypeError,
                            ValueError,
                        ):
                            pass


                    db.commit()


            except (
                TypeError,
                ValueError,
            ):
                pass


    return {
        "received":
            True,

        "event_type":
            event["type"],
    }