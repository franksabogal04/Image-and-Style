@router.post(
    "/appointment/{appointment_id}/cancel"
)
def cancel_appointment_by_staff(
    appointment_id: int,
    payload: StaffCancelRequest,
    db: Session = Depends(get_db),
    current_user: models.User = Depends(
        deps.get_current_user
    ),
):
    """
    Cancel an appointment without deleting its history.

    Owner/receptionist explicitly chooses whether a paid
    booking deposit should be refunded or retained.
    """

    if current_user.role not in (
        "owner",
        "receptionist",
    ):
        raise HTTPException(
            status_code=403,
            detail=(
                "Only the owner or receptionist "
                "can cancel appointments."
            ),
        )


    appointment = _get_appointment(
        appointment_id,
        db,
    )


    if appointment.booking_status in (
        "cancelled",
        "late_cancelled",
    ):
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment has already "
                "been cancelled."
            ),
        )


    # Do not make a deposit decision while Stripe payment
    # confirmation is still waiting for its webhook.
    pending_payment = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "pending",
        )
        .first()
    )


    if pending_payment:
        raise HTTPException(
            status_code=409,
            detail=(
                "A payment is still processing. Wait for "
                "Stripe confirmation before cancelling."
            ),
        )


    paid_payments = (
        db.query(models.Payment)
        .filter(
            models.Payment.appointment_id
            == appointment.id,
            models.Payment.status
            == "paid",
        )
        .order_by(
            models.Payment.created_at.asc()
        )
        .all()
    )


    deposit_amount = round(
        float(
            appointment.deposit_amount
            or 0.0
        ),
        2,
    )


    # No payment exists, so cancellation only releases
    # the appointment time.
    if not paid_payments:
        appointment.booking_status = (
            "cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )

        db.commit()


        return {
            "ok":
                True,

            "appointment_id":
                appointment.id,

            "booking_status":
                "cancelled",

            "deposit_refunded":
                False,

            "deposit_retained":
                False,

            "refund_amount":
                0.0,

            "message":
                (
                    "Appointment cancelled. "
                    "No payment had been recorded."
                ),
        }


    if deposit_amount <= 0:
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment has a completed payment "
                "but no booking deposit. Use the regular "
                "refund flow instead."
            ),
        )


    deposit_payment = None


    for payment in paid_payments:
        payment_amount = round(
            float(
                payment.amount
                or 0.0
            ),
            2,
        )

        if (
            abs(
                payment_amount
                - deposit_amount
            )
            <= 0.01
        ):
            deposit_payment = payment
            break


    if not deposit_payment:
        raise HTTPException(
            status_code=409,
            detail=(
                "The completed booking deposit could "
                "not be identified."
            ),
        )


    successful_refunds = (
        db.query(models.Refund)
        .filter(
            models.Refund.appointment_id
            == appointment.id,
            models.Refund.status
            == "succeeded",
        )
        .all()
    )


    net_paid = round(
        sum(
            float(payment.amount or 0.0)
            for payment in paid_payments
        )
        -
        sum(
            float(refund.amount or 0.0)
            for refund in successful_refunds
        ),
        2,
    )


    if net_paid > deposit_amount + 0.005:
        raise HTTPException(
            status_code=409,
            detail=(
                "This appointment has payments beyond "
                "the booking deposit. Use the regular "
                "refund flow before cancelling."
            ),
        )


    previous_deposit_refund = (
        db.query(models.RefundLine)
        .join(
            models.Refund,
            models.Refund.id
            == models.RefundLine.refund_id
        )
        .filter(
            models.Refund.appointment_id
            == appointment.id,
            models.Refund.payment_id
            == deposit_payment.id,
            models.Refund.status.in_(
                (
                    "pending",
                    "succeeded",
                )
            ),
            models.RefundLine.kind
            == "deposit",
        )
        .first()
    )


    if previous_deposit_refund:
        raise HTTPException(
            status_code=409,
            detail=(
                "This deposit has already been "
                "refunded or is being refunded."
            ),
        )


    # The owner/receptionist chose to retain the deposit.
    if not payload.refund_deposit:
        appointment.booking_status = (
            "cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )

        db.commit()


        return {
            "ok":
                True,

            "appointment_id":
                appointment.id,

            "booking_status":
                "cancelled",

            "deposit_refunded":
                False,

            "deposit_retained":
                True,

            "deposit_amount":
                deposit_amount,

            "refund_amount":
                0.0,

            "message":
                (
                    "Appointment cancelled and "
                    "deposit retained."
                ),
        }


    if deposit_payment.method != "card":
        raise HTTPException(
            status_code=400,
            detail=(
                "The booking deposit is not a "
                "card payment."
            ),
        )


    if not STRIPE_SECRET_KEY:
        raise HTTPException(
            status_code=500,
            detail=(
                "Stripe is not configured "
                "(missing STRIPE_SECRET_KEY)."
            ),
        )


    if not deposit_payment.stripe_payment_intent_id:
        raise HTTPException(
            status_code=409,
            detail=(
                "The deposit payment does not have "
                "a Stripe PaymentIntent ID."
            ),
        )


    refund_amount = round(
        float(
            deposit_payment.amount
            or 0.0
        ),
        2,
    )


    reason = (
        payload.reason.strip()
        if (
            payload.reason
            and payload.reason.strip()
        )
        else (
            "Appointment cancelled by owner/receptionist; "
            "deposit refunded by staff decision."
        )
    )


    refund = models.Refund(
        appointment_id=
            appointment.id,

        payment_id=
            deposit_payment.id,

        method=
            deposit_payment.method,

        status=
            "pending",

        amount=
            refund_amount,

        reason=
            reason,
    )


    db.add(refund)
    db.flush()


    db.add(
        models.RefundLine(
            refund_id=
                refund.id,

            kind=
                "deposit",

            sale_id=
                None,

            staff_id=
                appointment.staff_id,

            description=
                "Booking Deposit",

            quantity=
                1,

            subtotal=
                refund_amount,

            tax_amount=
                0.0,

            total=
                refund_amount,
        )
    )


    # Preserve the attempted refund before calling Stripe.
    db.commit()
    db.refresh(refund)


    try:
        stripe_refund = stripe.Refund.create(
            payment_intent=
                deposit_payment
                .stripe_payment_intent_id,

            amount=
                int(
                    round(
                        refund_amount
                        * 100
                    )
                ),

            metadata={
                "appointment_id":
                    str(
                        appointment.id
                    ),

                "payment_id":
                    str(
                        deposit_payment.id
                    ),

                "refund_id":
                    str(
                        refund.id
                    ),

                "refund_kind":
                    "deposit",

                "cancelled_by_user_id":
                    str(
                        current_user.id
                    ),
            },
        )


        stripe_status = (
            stripe_refund.get(
                "status"
            )
            or "succeeded"
        )


        if stripe_status not in (
            "succeeded",
            "pending",
        ):
            refund.status = (
                "failed"
            )

            db.commit()

            raise HTTPException(
                status_code=502,
                detail=(
                    "Stripe did not complete "
                    "the deposit refund."
                ),
            )


        refund.stripe_refund_id = (
            stripe_refund.get(
                "id"
            )
        )

        refund.status = (
            "succeeded"
            if stripe_status == "succeeded"
            else "pending"
        )

        appointment.booking_status = (
            "cancelled"
        )

        appointment.deposit_expires_at = (
            None
        )

        db.commit()
        db.refresh(refund)


    except HTTPException:
        raise


    except stripe.error.StripeError as error:
        refund.status = (
            "failed"
        )

        db.commit()

        message = (
            getattr(
                error,
                "user_message",
                None,
            )
            or str(error)
        )

        raise HTTPException(
            status_code=502,
            detail=(
                f"Stripe deposit refund error: "
                f"{message}"
            ),
        )


    except Exception as error:
        refund.status = (
            "failed"
        )

        db.commit()

        raise HTTPException(
            status_code=500,
            detail=(
                f"Deposit cancellation error: "
                f"{str(error)}"
            ),
        )


    return {
        "ok":
            True,

        "appointment_id":
            appointment.id,

        "booking_status":
            "cancelled",

        "deposit_refunded":
            True,

        "deposit_retained":
            False,

        "deposit_amount":
            deposit_amount,

        "refund_id":
            refund.id,

        "refund_status":
            refund.status,

        "refund_amount":
            refund_amount,

        "message":
            (
                "Appointment cancelled and "
                "deposit refund submitted."
            ),
    }



